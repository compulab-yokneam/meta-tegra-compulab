#!/bin/sh
# SPDX-License-Identifier: MIT
# Explicit Ubuntu desktop delegation; never guess a user, seat or display.
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
fail() { printf 'ERROR: %s\n' "$*" >&2; exit 2; }
backend=${1-}
case "$backend" in
    --auto|--x11|--wayland) shift ;;
    *) fail 'use --auto, --x11 or --wayland' ;;
esac
[ "$#" -gt 0 ] || fail 'a command is required'
if [ "$(id -u)" -eq 0 ]; then
    desktop_user=${EDGE_AI_DESKTOP_USER-}
    [ -n "$desktop_user" ] || fail 'set EDGE_AI_DESKTOP_USER to the logged-in Ubuntu desktop user'
    desktop_uid=$(id -u "$desktop_user") || fail 'unknown desktop user'
    [ "$desktop_uid" -ne 0 ] || fail 'the desktop user must not be root'
    runtime_dir=/run/user/$desktop_uid
    [ -d "$runtime_dir" ] || fail 'the selected desktop user has no runtime directory'
    if [ "$backend" = --auto ]; then
        # The child discovers only this selected user's desktop session.
        exec runuser -u "$desktop_user" -- env PATH="$PATH" \
            XDG_RUNTIME_DIR="$runtime_dir" XDG_SESSION_TYPE= \
            DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime_dir/bus" \
            DISPLAY="${EDGE_AI_DISPLAY:-${DISPLAY-}}" \
            XAUTHORITY="${EDGE_AI_XAUTHORITY:-${XAUTHORITY-}}" \
            WAYLAND_DISPLAY="${EDGE_AI_WAYLAND_DISPLAY:-${WAYLAND_DISPLAY-}}" "$@"
    fi
    if [ "$backend" = --x11 ]; then
        display=${EDGE_AI_DISPLAY:-${DISPLAY-}}
        authority=${EDGE_AI_XAUTHORITY:-${XAUTHORITY-}}
        [ -n "$display" ] && [ -n "$authority" ] ||
            fail 'set EDGE_AI_DISPLAY and EDGE_AI_XAUTHORITY for the selected X11/XWayland session'
        runuser -u "$desktop_user" -- test -r "$authority" ||
            fail 'the selected desktop user cannot read the Xauthority file'
        exec runuser -u "$desktop_user" -- env \
            PATH="$PATH" XDG_RUNTIME_DIR="$runtime_dir" GDK_BACKEND=x11 \
            DISPLAY="$display" XAUTHORITY="$authority" "$@"
    fi
    # The GStreamer launcher validates/discovers the selected user's socket.
    exec runuser -u "$desktop_user" -- env PATH="$PATH" \
        XDG_RUNTIME_DIR="$runtime_dir" \
        WAYLAND_DISPLAY="${EDGE_AI_WAYLAND_DISPLAY:-${WAYLAND_DISPLAY-}}" "$@"
fi
XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
export XDG_RUNTIME_DIR
if [ "$backend" = --x11 ]; then
    [ -n "${DISPLAY-}" ] || fail 'run from the desktop or set DISPLAY/XAUTHORITY explicitly'
    export GDK_BACKEND=x11
fi
exec "$@"
