#!/bin/bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 CompuLab Ltd.
# Source this file, not the legacy R36 wrapper. Loading performs no operations.

if [ -z "${BASH_VERSION:-}" ]; then
    printf 'CompuLab SDK wrapper requires Bash.\n' >&2
    return 2 2>/dev/null || exit 2
fi
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    printf 'Source this wrapper: source /path/to/Linux_for_Tegra/compulab-l4t.env\n' >&2
    exit 2
fi
if declare -F overlays_mount >/dev/null || \
   declare -F create_disk_image_func >/dev/null; then
    printf 'Legacy wrapper already loaded; start a clean Bash and source only this SDK wrapper.\n' >&2
    return 2
fi

_compulab_wrapper_error()
{
    printf 'CompuLab SDK: %s\n' "$*" >&2
}

_compulab_target_name()
{
    case "${1,,}" in
        auto|device|connected) printf 'auto\n' ;;
        edge-ai|edge-ai-nx-16g|nx16|nx-16g|0000|0)
            printf 'edge-ai-nx-16g\n' ;;
        edge-ai-nx-8g|nx8|nx-8g|0001|1)
            printf 'edge-ai-nx-8g\n' ;;
        edge-ai-nano-8g|na8|nano8|nano-8g|0003|3)
            printf 'edge-ai-nano-8g\n' ;;
        edge-ai-nano-4g|na4|nano4|nano-4g|0004|4)
            printf 'edge-ai-nano-4g\n' ;;
        *) _compulab_wrapper_error "unsupported target: $1"; return 2 ;;
    esac
}

_compulab_logo_name()
{
    case "${1,,}" in
        clab|clab-logo|logo) printf 'clab-logo\n' ;;
        nvidia|nvidia-logo) printf 'nvidia-logo\n' ;;
        none|no-logo|nologo) printf 'no-logo\n' ;;
        *) _compulab_wrapper_error "unsupported bootloader style: $1"; return 2 ;;
    esac
}

_compulab_wrapper_choose()
{
    local prompt="$1" choice REPLY PS3
    shift
    [[ -t 0 ]] || {
        _compulab_wrapper_error 'no terminal; supply a selection as an argument'
        return 2
    }
    PS3="${prompt} > "
    select choice in "$@" cancel; do
        [[ $choice != cancel ]] || return 1
        if [[ -n $choice ]]; then
            printf '%s\n' "$choice"
            return 0
        fi
        printf 'Select one of the listed numbers.\n' >&2
    done
    return 1
}

select_device()
{
    [[ $# -le 1 ]] || { _compulab_wrapper_error 'select_device takes one target'; return 2; }
    local selected
    if [[ $# == 1 ]]; then
        selected=$1
    elif [[ -n ${dev_type:-} ]]; then
        selected=$dev_type
    else
        selected=$(_compulab_wrapper_choose Target edge-ai-nx-16g edge-ai-nx-8g \
            edge-ai-nano-8g edge-ai-nano-4g auto) || return "$?"
    fi
    selected=$(_compulab_target_name "$selected") || return "$?"
    export EDGE_AI="$selected"
}

select_target() { select_device "$@"; }
select_config() { select_device "$@"; }
current_device() { _compulab_target_name "${EDGE_AI:-auto}"; }

select_bootloader()
{
    [[ $# -le 1 ]] || { _compulab_wrapper_error 'select_bootloader takes one style'; return 2; }
    local selected
    if [[ $# == 1 ]]; then
        selected=$1
    elif [[ -n ${bl_type:-} ]]; then
        selected=$bl_type
    else
        selected=$(_compulab_wrapper_choose Bootloader clab-logo nvidia-logo no-logo) || return "$?"
    fi
    selected=$(_compulab_logo_name "$selected") || return "$?"
    export EDGE_AI_UEFI_LOGO_STYLE="$selected"
}

current_bootloader()
{
    _compulab_logo_name "${EDGE_AI_UEFI_LOGO_STYLE:-clab-logo}"
}

_compulab_recovery_devices()
{
    # Same recovery PID set as the SDK's nvautoflash/kernel-flash helpers.
    # USB identifies a module candidate, NOT its carrier or authoritative SKU.
    local node vendor product target
    for node in /sys/bus/usb/devices/*; do
        [[ -r $node/idVendor && -r $node/idProduct ]] || continue
        IFS= read -r vendor < "$node/idVendor" || continue
        [[ ${vendor,,} == 0955 ]] || continue
        IFS= read -r product < "$node/idProduct" || continue
        case "${product,,}" in
            7323) target=edge-ai-nx-16g ;;
            7423) target=edge-ai-nx-8g ;;
            7523) target=edge-ai-nano-8g ;;
            7623) target=edge-ai-nano-4g ;;
            7023|7223|7026|7226|7326) target=unsupported ;;
            *) continue ;;
        esac
        printf '%s\t%s\t%s\n' "${node##*/}" "$target" "${product,,}"
    done
}

_compulab_online_record()
{
    local records instance target product extra candidate='' count=0 selected
    selected=$(current_device) || return "$?"
    if [[ $# == 1 ]]; then
        records=$1
    else
        records=$(_compulab_recovery_devices) || return "$?"
    fi
    while IFS=$'\t' read -r instance target product extra; do
        [[ -n $instance ]] || continue
        [[ $instance =~ ^[0-9]+-[0-9]+([.][0-9]+)*$ && \
           $product =~ ^[0-9a-f]{4}$ && -z $extra ]] || {
            _compulab_wrapper_error 'invalid recovery-device record'; return 2
        }
        count=$((count + 1))
        candidate="${instance}"$'\t'"${target}"$'\t'"${product}"
    done <<< "$records"
    [[ $count == 1 ]] || {
        _compulab_wrapper_error "exactly one recovery device is required; found $count"
        return 2
    }
    IFS=$'\t' read -r instance target product <<< "$candidate"
    case "$target" in
        edge-ai-nx-16g|edge-ai-nx-8g|edge-ai-nano-8g|edge-ai-nano-4g) ;;
        *) _compulab_wrapper_error "unsupported recovery product: $product"; return 2 ;;
    esac
    [[ $selected == auto || $selected == "$target" ]] || {
        _compulab_wrapper_error "selected $selected but USB identifies $target; refusing flash"
        return 2
    }
    printf '%s\n' "$candidate"
}

detect_device()
{
    local record instance target product
    record=$(_compulab_online_record) || return "$?"
    IFS=$'\t' read -r instance target product <<< "$record"
    printf '%s\n' "$target"
}

_compulab_wrapper_check_sdk()
(
    local sdk="$1" target="$2" logo="$3" early="$4"
    local FAB BOARDREV CHIPREV CHIP_SKU RAMCODE RAMCODE_ID
    [[ $sdk == "${_COMPULAB_SDK_ROOT}" && $L4T_ROOT == "$sdk" && \
       $sdk =~ ^/[A-Za-z0-9_./+-]+$ ]] || {
        _compulab_wrapper_error 'SDK root changed or contains unsupported shell characters'
        exit 2
    }
    [[ $early == 0 || $early == 1 ]] || {
        _compulab_wrapper_error 'EDGE_AI_EARLY_TTY1 must be 0 or 1'; exit 2
    }
    [[ ${ROOTFS_AB:-0} == 0 && ${ROOTFS_ENC:-0} == 0 ]] || {
        _compulab_wrapper_error 'A/B or encrypted layouts need their own reviewed native workflow'
        exit 2
    }
    [[ -f $sdk/flash.sh && -d $sdk/rootfs && \
       -f $sdk/tools/kernel_flash/flash_l4t_t234_nvme.xml && \
       -f $sdk/bootloader/generic/cfg/flash_t234_qspi.xml && \
       -f $sdk/kernel/dtb/BootOrderNvme.dtbo ]] || {
        _compulab_wrapper_error 'required native SDK inputs are missing'; exit 2
    }
    [[ -f $sdk/compulab/tools/verify-flash-inputs.py ]] || {
        _compulab_wrapper_error 'SDK flash-input verifier is missing'; exit 2
    }
    [[ -f $sdk/compulab/tools/apply-massflash-initrd-fix.py ]] || {
        _compulab_wrapper_error 'SDK massflash initrd fix is missing'; exit 2
    }
    # Native flashing legitimately regenerates initrds and root-device APPEND
    # arguments. Check their payloads, not an immutable pre-flash archive hash.
    # Static inputs retain their original checksum/ABI checks; no receipt is
    # refreshed to make an unexpected change appear valid.
    /usr/bin/python3 -B "$sdk/compulab/tools/verify-flash-inputs.py" \
        --sdk-root "$sdk" >/dev/null || exit 1
    # Check the selected set without talking to hardware or changing globals.
    # Native flashing still discovers and verifies the real EEPROM separately.
    unset BOARDID BOARDSKU SKIP_EEPROM_CHECK FUSELEVEL chip_SKU
    compulab_platform_metadata "$target" || exit 2
    FAB=$EDGE_AI_DEFAULT_FAB
    BOARDREV=$EDGE_AI_DEFAULT_BOARDREV CHIPREV=$EDGE_AI_DEFAULT_CHIPREV
    CHIP_SKU=$EDGE_AI_EXPECTED_CHIP_SKU
    RAMCODE=$EDGE_AI_EXPECTED_RAMCODE RAMCODE_ID=$EDGE_AI_EXPECTED_RAMCODE
    _compulab_image_check_sdk "$sdk" "$target" "$EDGE_AI_EXPECTED_SKU" "$logo" "$early"
)

_compulab_wrapper_confirm()
{
    local description="$1" answer
    [[ -t 0 ]] || {
        _compulab_wrapper_error 'write requires a terminal confirmation or explicit --yes'
        return 2
    }
    printf '%s\n' "$description" >&2
    read -r -p 'Type YES to continue: ' answer || return 1
    [[ $answer == YES ]] || { _compulab_wrapper_error 'cancelled'; return 1; }
}

_compulab_wrapper_print_command()
{
    printf 'SDK: %s\n' "$L4T_ROOT"
    printf 'Command:'
    printf ' %q' "$@"
    printf '\n'
}

_compulab_wrapper_logged_command()
(
    local logfile="$1"
    local -a statuses
    shift
    # Capture both statuses before any other command. A logging failure must
    # not hide a failed generation or allow a subsequent physical flash.
    set +e
    # Restrict the log writer only. Tightening the native process umask would
    # make newly generated root-owned images unreadable to user preflight.
    "$@" 2>&1 | (umask 077; tee -- "$logfile")
    statuses=("${PIPESTATUS[@]}")
    [[ ${statuses[0]} == 0 ]] || exit "${statuses[0]}"
    [[ ${statuses[1]} == 0 ]] || {
        _compulab_wrapper_error "could not record native output: $logfile"
        exit "${statuses[1]}"
    }
)

_compulab_wait_for_recovery_record()
{
    local expected="$1" records actual attempt
    # EEPROM reads can briefly re-enumerate the same USB recovery device.
    # Wait only for absence; never wait through an ambiguous/wrong device.
    for attempt in {1..10}; do
        records=$(_compulab_recovery_devices) || return "$?"
        if [[ -n $records ]]; then
            actual=$(_compulab_online_record "$records") || return "$?"
            [[ $actual == "$expected" ]] || {
                _compulab_wrapper_error 'recovery-device selection changed; refusing flash'
                return 2
            }
            return 0
        fi
        [[ $attempt == 10 ]] || sleep 1 || return "$?"
    done
    _compulab_wrapper_error 'recovery device did not return after generation; refusing flash'
    return 2
}

_compulab_wrapper_flash()
{
    local action="$1" option dry=0 yes=0 no_flash=0
    local record target instance product logo early description images_helper
    local external="${COMPULAB_EXTERNAL_DEVICE:-nvme0n1p1}"
    shift
    for option in "$@"; do
        case "$option" in
            --dry-run) dry=1 ;;
            --yes) yes=1 ;;
            --no-flash) no_flash=1 ;;
            --help|-h) compulab_help; return 0 ;;
            *) _compulab_wrapper_error "unsupported option: $option"; return 2 ;;
        esac
    done
    record=$(_compulab_online_record) || return "$?"
    IFS=$'\t' read -r instance target product <<< "$record"
    logo=$(current_bootloader) || return "$?"
    early=${EDGE_AI_EARLY_TTY1:-0}
    [[ $external =~ ^nvme[0-9]+n[0-9]+p1$ ]] || {
        _compulab_wrapper_error 'COMPULAB_EXTERNAL_DEVICE must name a board NVMe APP partition'
        return 2
    }
    _compulab_wrapper_check_sdk "$L4T_ROOT" "$target" "$logo" "$early" || return "$?"
    images_helper="$L4T_ROOT/compulab/tools/check-deployment-images.py"
    if [[ $action == full && ( ! -f $images_helper || -L $images_helper ) ]]; then
        _compulab_wrapper_error 'deployment image verifier is missing'; return 2
    fi
    local -a command=(sudo -n env
        -u BOARDID -u BOARDSKU -u FAB -u BOARDREV -u CHIPREV
        -u CHIP_SKU -u chip_SKU -u RAMCODE -u RAMCODE_ID
        -u FUSELEVEL -u fuselevel -u SKIP_EEPROM_CHECK
        -u ROOTFS_AB -u ROOTFS_ENC -u EXT_NUM_SECTORS -u EXTDEV_ON_TARGET
        -u no_flash -u flash_only -u OPTIONS -u EXTOPTIONS
        -u massflash_mode_opt -u UNIFIED_FLASH
        "EDGE_AI_UEFI_LOGO_STYLE=$logo" "EDGE_AI_EARLY_TTY1=$early"
        ADDITIONAL_DTB_OVERLAY_OPT=BootOrderNvme.dtbo)
    local -a mode_options=()
    local -a flash_command=("${command[@]}")
    [[ $no_flash == 0 ]] || mode_options+=(--no-flash)
    case "$action" in
        full)
            description="Overwrite $target QSPI firmware and board NVMe contents?"
            command+=(./tools/kernel_flash/l4t_initrd_flash.sh
                --no-flash
                --external-device "$external"
                -c tools/kernel_flash/flash_l4t_t234_nvme.xml
                -p '-c bootloader/generic/cfg/flash_t234_qspi.xml'
                --usb-instance "$instance" --network usb0 --showlogs
                "$target" external)
            flash_command+=(./tools/kernel_flash/l4t_initrd_flash.sh
                --flash-only --usb-instance "$instance" --network usb0 --showlogs
                "$target" external)
            ;;
        bootloader)
            description="Overwrite $target QSPI firmware only (leave NVMe rootfs unchanged)?"
            command+=(./flash.sh "${mode_options[@]}" --no-systemimg
                -c bootloader/generic/cfg/flash_t234_qspi.xml
                --usb-instance "$instance" "$target" external)
            ;;
        *) _compulab_wrapper_error 'unknown flashing action'; return 2 ;;
    esac
    if [[ $no_flash == 1 ]]; then
        description="Prepare $target $action images only (no QSPI or NVMe flashing)?"
        printf 'Mode: image generation only (--no-flash); no QSPI or NVMe flashing.\n'
    else
        printf 'Mode: generate images and flash the connected board.\n'
    fi
    _compulab_wrapper_print_command "${command[@]}"
    if [[ $action == full && $no_flash == 0 ]]; then
        printf 'After generation succeeds, the wrapper will run this physical flash command:\n'
        _compulab_wrapper_print_command "${flash_command[@]}"
    fi
    [[ $dry == 0 ]] || return 0
    [[ $yes == 1 ]] || _compulab_wrapper_confirm "$description" || return "$?"
    [[ $(id -u) != 0 ]] || {
        _compulab_wrapper_error 'use a normal user shell; the wrapper invokes sudo'; return 2
    }
    sudo -n true || { _compulab_wrapper_error 'run sudo -v before starting the operation'; return 1; }
    # Recheck the sole device immediately before executing any write command.
    [[ $(_compulab_online_record) == "$record" ]] || {
        _compulab_wrapper_error 'recovery-device selection changed; refusing flash'; return 2
    }
    if [[ $action == bootloader ]]; then
        (cd -- "$L4T_ROOT" && "${command[@]}")
        return "$?"
    fi
    (
        local logdir logparent before status
        logparent=$(readlink -e -- "${TMPDIR:-/tmp}") || exit 1
        logdir=$(umask 077; mktemp -d -- "$logparent/compulab-deploy.XXXXXXXX") || exit 1
        printf 'Deployment logs (on this host): %s\n' "$logdir"
        cd -- "$L4T_ROOT" || exit 1
        (umask 077; : > "$logdir/snapshot.log") || exit 1
        if before=$(/usr/bin/python3 -B "$images_helper" \
                --sdk-root "$L4T_ROOT" --snapshot 2>"$logdir/snapshot.log"); then
            :
        else
            status=$?
            _compulab_wrapper_error "cannot inspect existing images (exit $status); see $logdir/snapshot.log"
            exit "$status"
        fi
        printf '[1/2] Generate deployment images; no physical flash in this phase.\n'
        if _compulab_wrapper_logged_command "$logdir/generate.log" "${command[@]}"; then
            printf '[1/2] Image generation completed.\n'
        else
            status=$?
            _compulab_wrapper_error "generation failed (exit $status); see $logdir/generate.log"
            exit "$status"
        fi
        if [[ $no_flash == 1 ]]; then
            printf 'Explicit --no-flash requested: physical flash skipped. Logs: %s\n' "$logdir"
            exit 0
        fi
        printf 'Validating generated images and the APP payload checksum...\n'
        if _compulab_wrapper_logged_command "$logdir/images.log" \
                /usr/bin/python3 -B "$images_helper" --sdk-root "$L4T_ROOT" \
                --target "$target" --external-device "$external" \
                --logo "$logo" --before-json "$before"; then
            :
        else
            status=$?
            _compulab_wrapper_error "generated images rejected (exit $status); flash not started; see $logdir/images.log"
            exit "$status"
        fi
        # Long generation can outlive the user's cached sudo authorization.
        # Interactive users may renew it; unattended runs fail rather than
        # silently skipping the physical phase or accepting a password in argv.
        if ! sudo -n true; then
            _compulab_wrapper_error 'sudo authorization expired before flashing'
            if [[ -t 0 ]]; then
                sudo -v || exit "$?"
            else
                _compulab_wrapper_error "physical flash not started; renew sudo authorization; logs: $logdir"
                exit 1
            fi
        fi
        _compulab_wait_for_recovery_record "$record" || exit "$?"
        printf '[2/2] Start actual QSPI + NVMe flashing (--flash-only).\n'
        if _compulab_wrapper_logged_command "$logdir/flash.log" "${flash_command[@]}"; then
            printf '[2/2] Native flash command completed successfully. Logs: %s\n' "$logdir"
        else
            status=$?
            _compulab_wrapper_error "physical flash command failed (exit $status); see $logdir/flash.log"
            exit "$status"
        fi
    )
}

deploy_bootloader_rootfs() { _compulab_wrapper_flash full "$@"; }
deploy_bootloader() { _compulab_wrapper_flash bootloader "$@"; }
compulab_flash() { deploy_bootloader_rootfs "$@"; }

_compulab_massflash_output_check()
{
    local target="$1" path
    for path in "$L4T_ROOT/mfi_$target" "$L4T_ROOT/mfi_$target.tar.gz"; do
        [[ ! -e $path && ! -L $path ]] || {
            _compulab_wrapper_error "massflash output already exists; archive it first: $path"
            return 2
        }
    done
}

_compulab_wrapper_massflash()
(
    local scope="$1" dry=0 yes=0 count=5 target logo early records record=''
    local instance='' product offline=0 lock_fd lock_path flash_options lock_umask
    local external="${COMPULAB_EXTERNAL_DEVICE:-nvme0n1p1}"
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry=1 ;;
            --yes) yes=1 ;;
            --massflash)
                [[ $# -ge 2 ]] || {
                    _compulab_wrapper_error '--massflash requires a device count'; exit 2
                }
                count=$2
                shift
                ;;
            --help|-h) compulab_help; exit 0 ;;
            *) _compulab_wrapper_error "unsupported option: $1"; exit 2 ;;
        esac
        shift
    done
    [[ $count =~ ^[1-9][0-9]?$ ]] && (( count <= 64 )) || {
        _compulab_wrapper_error 'massflash device count must be between 1 and 64'
        exit 2
    }
    target=$(current_device) || exit "$?"
    records=$(_compulab_recovery_devices) || exit "$?"
    if [[ -n $records ]]; then
        record=$(_compulab_online_record) || exit "$?"
        IFS=$'\t' read -r instance target product <<< "$record"
    else
        [[ $target != auto ]] || {
            _compulab_wrapper_error 'offline massflash preparation requires an explicit target'
            exit 2
        }
        offline=1
    fi
    logo=$(current_bootloader) || exit "$?"
    early=${EDGE_AI_EARLY_TTY1:-0}
    [[ $external =~ ^nvme[0-9]+n[0-9]+p1$ ]] || {
        _compulab_wrapper_error 'COMPULAB_EXTERNAL_DEVICE must name a board NVMe APP partition'
        exit 2
    }
    _compulab_wrapper_check_sdk "$L4T_ROOT" "$target" "$logo" "$early" || exit "$?"
    [[ -f $L4T_ROOT/compulab/tools/prepare-massflash-package.py ]] || {
        _compulab_wrapper_error 'massflash package finalizer is missing'; exit 2
    }
    _compulab_massflash_output_check "$target" || exit "$?"
    local -a command=(sudo -n env
        -u BOARDID -u BOARDSKU -u FAB -u BOARDREV -u CHIPREV
        -u CHIP_SKU -u chip_SKU -u RAMCODE -u RAMCODE_ID
        -u FUSELEVEL -u fuselevel -u SKIP_EEPROM_CHECK -u FORCE_ACCESS
        -u ROOTFS_AB -u ROOTFS_ENC -u EXT_NUM_SECTORS -u EXTDEV_ON_TARGET
        -u UNIFIED_FLASH
        "EDGE_AI_UEFI_LOGO_STYLE=$logo" "EDGE_AI_EARLY_TTY1=$early"
        ADDITIONAL_DTB_OVERLAY_OPT=BootOrderNvme.dtbo)
    if [[ $offline == 1 ]]; then
        # Only preparation with no recovery device may use reviewed defaults.
        # A connected board always keeps native EEPROM/fuse discovery.
        compulab_platform_metadata "$target" || exit 2
        command+=(BOARDID=3767 "BOARDSKU=$EDGE_AI_EXPECTED_SKU"
            "FAB=$EDGE_AI_DEFAULT_FAB" "BOARDREV=$EDGE_AI_DEFAULT_BOARDREV"
            "CHIPREV=$EDGE_AI_DEFAULT_CHIPREV" "CHIP_SKU=$EDGE_AI_EXPECTED_CHIP_SKU"
            "RAMCODE=$EDGE_AI_EXPECTED_RAMCODE" "RAMCODE_ID=$EDGE_AI_EXPECTED_RAMCODE"
            FUSELEVEL=fuselevel_production)
    fi
    command+=(./tools/kernel_flash/l4t_initrd_flash.sh
        --no-flash --massflash "$count" --keep --network usb0 --showlogs)
    flash_options='-c bootloader/generic/cfg/flash_t234_qspi.xml'
    case "$scope" in
        bootloader)
            command+=(--qspi-only)
            flash_options+=' --no-systemimg'
            ;;
        full)
            command+=(--external-device "$external"
                -c tools/kernel_flash/flash_l4t_t234_nvme.xml)
            ;;
        *) _compulab_wrapper_error 'unknown massflash scope'; exit 2 ;;
    esac
    if [[ -n $instance ]]; then
        command+=(--usb-instance "$instance")
        # R39.2.1 drops the outer instance while spawning image generation.
        # Passing it through -p also pins internal/RCM flash.sh calls.
        flash_options+=" --usb-instance $instance"
    fi
    command+=(-p "$flash_options" "$target" external)
    local -a finalize=(sudo -n /usr/bin/python3 -B
        "$L4T_ROOT/compulab/tools/prepare-massflash-package.py"
        --sdk-root "$L4T_ROOT" --target "$target" --scope "$scope"
        --massflash "$count" --logo "$logo" --early-tty1 "$early")
    printf 'Massflash preparation: target=%s scope=%s devices=%s logo=%s\n' \
        "$target" "$scope" "$count" "$logo"
    printf 'Archive: %s/mfi_%s.tar.gz\n' "$L4T_ROOT" "$target"
    printf 'Preparation only (--no-flash); no QSPI or NVMe is flashed.\n'
    if [[ $offline == 1 ]]; then
        printf 'Offline defaults require matching module SKU/FAB/RAM code in the batch.\n'
    fi
    _compulab_wrapper_print_command "${command[@]}"
    _compulab_wrapper_print_command "${finalize[@]}"
    [[ $dry == 0 ]] || exit 0
    [[ $yes == 1 ]] || \
        _compulab_wrapper_confirm 'Prepare these new massflash package files?' || exit "$?"
    [[ $(id -u) != 0 ]] || {
        _compulab_wrapper_error 'use a normal user shell; the wrapper invokes sudo'; exit 2
    }
    sudo -n true || {
        _compulab_wrapper_error 'run sudo -v before starting the operation'; exit 1
    }
    command -v flock >/dev/null || {
        _compulab_wrapper_error 'flock is required for massflash preparation'; exit 2
    }
    # Serialize these two preparation APIs. Other SDK/native operations must
    # not run concurrently: they share bootloader/ and kernel_flash/images/.
    lock_path="$L4T_ROOT/.compulab-massflash.lock"
    [[ ! -L $lock_path && ( ! -e $lock_path || \
        ( -f $lock_path && -O $lock_path ) ) ]] || {
        _compulab_wrapper_error 'invalid massflash preparation lock'; exit 2
    }
    lock_umask=$(umask)
    umask 077
    exec {lock_fd}>> "$lock_path" || exit 1
    umask "$lock_umask"
    flock -n "$lock_fd" || {
        _compulab_wrapper_error 'another massflash preparation is running'; exit 2
    }
    _compulab_massflash_output_check "$target" || exit "$?"
    if [[ $offline == 1 ]]; then
        records=$(_compulab_recovery_devices) || exit "$?"
        [[ -z $records ]] || {
            _compulab_wrapper_error 'a recovery device appeared; retry with native discovery'
            exit 2
        }
    else
        [[ $(_compulab_online_record) == "$record" ]] || {
            _compulab_wrapper_error 'recovery-device selection changed; refusing preparation'
            exit 2
        }
    fi
    cd -- "$L4T_ROOT" || exit 1
    "${command[@]}" || exit "$?"
    "${finalize[@]}" || exit "$?"
    printf 'Prepared massflash archive: %s/mfi_%s.tar.gz\n' "$L4T_ROOT" "$target"
)

prepare_massflash_boot() { _compulab_wrapper_massflash bootloader "$@"; }
prepare_massflash_boot_rootfs() { _compulab_wrapper_massflash full "$@"; }

create_disk_image()
{
    local option dry=0 yes=0 target logo early image_size
    for option in "$@"; do
        case "$option" in
            --dry-run) dry=1 ;;
            --yes) yes=1 ;;
            --help|-h) compulab_help; return 0 ;;
            *) _compulab_wrapper_error "unsupported option: $option"; return 2 ;;
        esac
    done
    target=$(current_device) || return "$?"
    [[ $target != auto ]] || {
        _compulab_wrapper_error 'offline image creation requires select_device with an explicit board'
        return 2
    }
    logo=$(current_bootloader) || return "$?"
    early=${EDGE_AI_EARLY_TTY1:-0}
    image_size=${LOOP_DEV_SIZE_GB:-32}
    [[ $image_size =~ ^[1-9][0-9]{0,3}$ ]] && \
        (( image_size >= 12 && image_size <= 2048 )) || {
        _compulab_wrapper_error 'LOOP_DEV_SIZE_GB must be between 12 and 2048 GiB'; return 2
    }
    if [[ -n ${L4T_IMAGE:-} ]]; then
        [[ $L4T_IMAGE == /*.img && $L4T_IMAGE != /dev/* && \
           $L4T_IMAGE != /proc/* && $L4T_IMAGE != /sys/* && \
           ! -e $L4T_IMAGE && ! -L $L4T_IMAGE ]] || {
            _compulab_wrapper_error 'L4T_IMAGE must be a new absolute regular .img output'; return 2
        }
    fi
    _compulab_wrapper_check_sdk "$L4T_ROOT" "$target" "$logo" "$early" || return "$?"
    printf 'Offline image: target=%s logo=%s disk=%sGiB APP=%sGiB\n' \
        "$target" "$logo" "$image_size" "$((image_size - 8))"
    printf 'Output: %s\n' "${L4T_IMAGE:-new private image under $L4T_IMAGEDIR}"
    printf 'Only a newly owned loop image is written; no connected Jetson is flashed.\n'
    [[ $dry == 0 ]] || return 0
    [[ $yes == 1 ]] || _compulab_wrapper_confirm 'Create this new loop-backed disk image?' || return "$?"
    # Dynamic locals isolate stale R36/offline metadata without altering the
    # caller's environment. The backend derives reviewed defaults per target.
    local BOARDID='' BOARDSKU=-1 FAB='' BOARDREV='' CHIPREV=''
    local CHIP_SKU='' chip_SKU='' RAMCODE='' RAMCODE_ID=''
    local FUSELEVEL='' fuselevel='' SKIP_EEPROM_CHECK=''
    local ROOTFS_AB=0 ROOTFS_ENC=0
    local size="$image_size"
    _compulab_create_disk_image
}

compulab_status()
{
    printf 'SDK: %s\nTarget: %s\nBootloader: %s\nEarly tty1: %s\nImage size: %sGiB\n' \
        "$L4T_ROOT" "$(current_device)" "$(current_bootloader)" \
        "${EDGE_AI_EARLY_TTY1:-0}" "${LOOP_DEV_SIZE_GB:-32}"
    printf 'Recovery USB candidates (instance, module candidate, PID):\n'
    _compulab_recovery_devices
}

compulab_help()
{
    printf '%s\n' \
        'CompuLab JetPack 7.2.1 / R39.2.1 sourceable SDK wrapper' \
        '  select_device [NX16|NX8|NA8|NA4|edge-ai-...|auto]' \
        '  select_bootloader [clab-logo|nvidia-logo|no-logo]' \
        '  current_device / current_bootloader / detect_device / compulab_status' \
        '  create_disk_image [--dry-run|--yes]        New owned loop image only' \
        '  deploy_bootloader [--dry-run|--yes] [--no-flash]  Connected QSPI only' \
        '  deploy_bootloader_rootfs [--dry-run|--yes] [--no-flash]' \
        '                                            Connected QSPI + board NVMe' \
        '  prepare_massflash_boot [--dry-run|--yes] [--massflash N]   QSPI package' \
        '  prepare_massflash_boot_rootfs [--dry-run|--yes] [--massflash N]' \
        '                                            QSPI + NVMe package; default N=5' \
        '  devshell / simple_shell                   Explicit interactive menu' \
        'Offline images require an explicit target; online auto uses USB then native EEPROM checks.' \
        'Writes require confirmation or --yes; run sudo -v first for noninteractive sudo.' \
        'Deploy commands flash by default; --no-flash only generates images (unlike --dry-run).' \
        'Never source the old R36 file or bulk-update this prepared SDK.' \
        'Massflash preparation never flashes; use one homogeneous board batch per package.' \
        'A/B, encryption, fused-key provisioning and partclone are separate workflows.'
}

devshell()
{
    [[ -t 0 ]] || { _compulab_wrapper_error 'devshell requires a terminal'; return 2; }
    local action REPLY PS3='CompuLab SDK > '
    while :; do
        compulab_status
        select action in select_device select_bootloader create_disk_image \
            deploy_bootloader deploy_bootloader_rootfs prepare_massflash_boot \
            prepare_massflash_boot_rootfs compulab_help exit; do
            [[ -n $action ]] || continue
            [[ $action != exit ]] || return 0
            if "$action"; then :; else printf 'Operation cancelled or failed.\n' >&2; fi
            break
        done
        [[ -n $action ]] || return 0
    done
}

simple_shell() { devshell "$@"; }

_compulab_wrapper_load()
{
    local file root target logo early
    file=$(readlink -e -- "${BASH_SOURCE[0]}") || return 2
    root=${file%/*}
    [[ -f $root/flash.sh && -d $root/rootfs && \
       -f $root/compulab/host/image-builder.sh ]] || {
        _compulab_wrapper_error 'source the copy inside a prepared Linux_for_Tegra SDK'
        return 2
    }
    target=$(_compulab_target_name "${EDGE_AI:-auto}") || return "$?"
    logo=$(_compulab_logo_name "${EDGE_AI_UEFI_LOGO_STYLE:-clab-logo}") || return "$?"
    early=${EDGE_AI_EARLY_TTY1:-0}
    [[ $early == 0 || $early == 1 ]] || {
        _compulab_wrapper_error 'EDGE_AI_EARLY_TTY1 must be 0 or 1'; return 2
    }
    source "$root/compulab/host/image-builder.sh" || return "$?"
    _COMPULAB_SDK_ROOT=$root
    export L4T_ROOT="$root" ROOTFS="$root/rootfs"
    export L4T_WORKDIR="${L4T_WORKDIR:-$root/workdir}"
    export L4T_IMAGEDIR="${L4T_IMAGEDIR:-$root/workdir/images.d}"
    export L4T_IMAGE="${L4T_IMAGE:-}" LOOP_DEV_SIZE_GB="${LOOP_DEV_SIZE_GB:-32}"
    export EDGE_AI="$target" EDGE_AI_UEFI_LOGO_STYLE="$logo"
    export EDGE_AI_EARLY_TTY1="$early"
}

_compulab_wrapper_load
