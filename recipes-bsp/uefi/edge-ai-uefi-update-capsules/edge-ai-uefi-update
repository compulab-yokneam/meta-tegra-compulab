#!/bin/sh

set -eu

capsule_dir="@CAPSULE_DIR@"
efivars_dir="${EDGE_AI_UEFI_EFIVARS_DIR:-/sys/firmware/efi/efivars}"
platform_variable_guid="781e084c-a330-417c-b678-38e696380cb9"

read_platform_variable() {
    variable_file="${efivars_dir}/${1}-${platform_variable_guid}"
    [ -r "${variable_file}" ] || return 1
    dd if="${variable_file}" bs=1 skip=4 2>/dev/null | tr -d '\0'
}

select_machine() {
    found_spec=no
    for variable in TegraPlatformCompatSpec TegraPlatformSpec; do
        if ! platform_spec=$(read_platform_variable "$variable"); then
            continue
        fi
        found_spec=yes
        board_id=$(printf '%s' "$platform_spec" | cut -d- -f1)
        board_sku=$(printf '%s' "$platform_spec" | cut -d- -f3)

        case "$board_id:$board_sku" in
            3767:0000) machine=edge-ai-nx-16g ;;
            3767:0001) machine=edge-ai-nx-8g ;;
            3767:0003) machine=edge-ai-nano-8g ;;
            3767:0004) machine=edge-ai-nano-4g ;;
            *)
                echo "Unsupported $variable: $platform_spec" >&2
                continue
                ;;
        esac

        printf '%s|%s' "$machine" "$platform_spec"
        return 0
    done

    if [ "$found_spec" = no ]; then
        echo "Cannot read TegraPlatformCompatSpec or TegraPlatformSpec from UEFI variables." >&2
    else
        echo "The updater supports P3767 module SKUs 0000, 0001, 0003, and 0004." >&2
    fi
    return 1
}

usage() {
    echo "Usage: $0 {nvidia-logo|clab-logo|no-logo} [LEGACY_FMP_GUID]" >&2
    echo "Stages one complete UEFI boot-firmware capsule, then prompts for reboot." >&2
}

if [ "$#" -gt 2 ]; then
    usage
    exit 2
fi

case "${1-}" in
    nvidia|nvidia-logo)
        variant=nvidia-logo
        ;;
    clab|clab-logo)
        variant=clab-logo
        ;;
    none|no-logo)
        variant=no-logo
        ;;
    -h|--help)
        usage
        exit 0
        ;;
    *)
        usage
        exit 2
        ;;
esac

legacy_guid=${2-}
selection=$(select_machine)
machine=${selection%%|*}
platform_spec=${selection#*|}
if [ -n "${legacy_guid}" ]; then
    case "${legacy_guid}" in
        ????????-????-????-????-????????????) ;;
        *)
            echo "Invalid legacy FMP GUID: ${legacy_guid}" >&2
            exit 2
            ;;
    esac
    case "${legacy_guid}" in
        *[!0-9A-Fa-f-]*)
            echo "Invalid legacy FMP GUID: ${legacy_guid}" >&2
            exit 2
            ;;
    esac
    capsule="${capsule_dir}/${machine}-uefi-${variant}-from-${legacy_guid}.cap"
else
    capsule="${capsule_dir}/${machine}-uefi-${variant}.cap"
fi

if [ ! -s "${capsule}" ]; then
    echo "No matching capsule is installed: ${capsule}" >&2
    exit 1
fi

echo "Verifying installed UEFI capsules..."
(cd "${capsule_dir}" && sha256sum -c SHA256SUMS)

echo "Installed Tegra platform specification: ${platform_spec}"
echo "Detected module selects: $(basename "${capsule}")"
"${capsule_dir}/apply-uefi-capsule" "${capsule}"
echo "Reboot now to let UEFI consume the staged capsule."
