From 5dc371054298f01ed59064ee1c7829b13a7a7d79 Mon Sep 17 00:00:00 2001
From: balenaOS build <build@balena.io>
Date: Sat, 8 Aug 2026 14:42:00 +0000
Subject: [PATCH] build: Apply Edge-AI logo as a Git commit

Apply the binary logo mail patch after resetting edk2-nvidia. Using git am
keeps the source checkout clean while recording the exact logo inputs used by
the firmware build.

---
 build.sh | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/build.sh b/build.sh
index 32e5251..bb8b7e4 100755
--- a/build.sh
+++ b/build.sh
@@ -42,6 +42,10 @@ cd /build/nvidia-uefi/edk2 && \
     git apply ${edk2_patch} && \
     cd /build/nvidia-uefi/edk2-nvidia && \
     git reset --hard HEAD && \
+    git -c user.name="balenaOS build" \
+        -c user.email="build@balena.io" \
+        am /build/edge-ai-patches/0001-Logo-Add-CompuLab-Edge-AI-splash-screens_patch.txt && \
+    git diff --quiet && git diff --cached --quiet && \
     for edk2_nvidia_patch in ${edk2_nvidia_patches[@]}
     do
         git apply "${edk2_nvidia_patch}" ;
-- 
2.43.0
