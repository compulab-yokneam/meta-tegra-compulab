+++ b/build-support/jetpack-7.2-blacksail/replay-host-toolchain.sh
@@ -0,0 +1,65 @@
+#!/usr/bin/env bash
+# Reproduce the workspace-local GCC 12 C++ files used by the completed build.
+# This downloads and extracts packages; it does not install system packages.
+set -euo pipefail
+
+clab_build_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
+clab_host_tools="$clab_build_root/host-tools"
+clab_package_dir="$clab_host_tools/packages"
+clab_version='12.3.0-1ubuntu1~22.04.3'
+clab_system_gcc='/usr/lib/gcc/x86_64-linux-gnu/12'
+clab_workspace_gcc="$clab_host_tools/usr/lib/gcc/x86_64-linux-gnu/12"
+
+[[ $(dpkg --print-architecture) == amd64 ]] || {
+    printf '%s\n' 'This captured host-toolchain fix requires an amd64 Ubuntu host.' >&2
+    exit 1
+}
+for clab_package in gcc-12 libgcc-12-dev libstdc++6; do
+    clab_installed=$(dpkg-query -W -f='${Version}' "$clab_package")
+    [[ "$clab_installed" == "$clab_version" ]] || {
+        printf 'Expected installed %s=%s; found %s. No system packages were changed.\n' \
+            "$clab_package" "$clab_version" "$clab_installed" >&2
+        exit 1
+    }
+done
+[[ -x /usr/bin/gcc-12 && -d "$clab_system_gcc" ]]
+[[ -f /usr/lib/x86_64-linux-gnu/libstdc++.so.6 ]]
+[[ -f "$clab_host_tools/bin/g++-12" && -f "$clab_host_tools/cxx20-check.cpp" ]]
+
+mkdir -p "$clab_package_dir"
+for clab_package in g++-12 libstdc++-12-dev; do
+    clab_deb="$clab_package_dir/${clab_package}_${clab_version}_amd64.deb"
+    if [[ ! -f "$clab_deb" ]]; then
+        (cd -- "$clab_package_dir" && apt-get download "$clab_package=$clab_version")
+    fi
+done
+
+(
+    cd -- "$clab_package_dir"
+    printf '%s  %s\n' \
+        'c4123ea47a1d422ec43fb0918f670cfeb7bef1f26e6bf372fe15099fd42bbfcd' \
+        "g++-12_${clab_version}_amd64.deb" \
+        '250f538cb3a5dfbbb767e16cb3d840a2b113de1582bec155ea97600740a6ed1e' \
+        "libstdc++-12-dev_${clab_version}_amd64.deb" \
+        | sha256sum --check --strict
+)
+for clab_package in g++-12 libstdc++-12-dev; do
+    dpkg-deb --extract "$clab_package_dir/${clab_package}_${clab_version}_amd64.deb" "$clab_host_tools"
+done
+
+# The development package's libstdc++.so link uses the installed matching runtime.
+mkdir -p "$clab_host_tools/usr/lib/x86_64-linux-gnu"
+ln -sfn -- /usr/lib/x86_64-linux-gnu/libstdc++.so.6 \
+    "$clab_host_tools/usr/lib/x86_64-linux-gnu/libstdc++.so.6"
+# Supply the GCC support files that were already installed on the build host.
+for clab_support in "$clab_system_gcc"/*; do
+    clab_destination="$clab_workspace_gcc/${clab_support##*/}"
+    if [[ ! -e "$clab_destination" && ! -L "$clab_destination" ]]; then
+        ln -s -- "$clab_support" "$clab_destination"
+    fi
+done
+chmod +x "$clab_host_tools/bin/g++-12"
+"$clab_host_tools/bin/g++-12" -std=c++20 "$clab_host_tools/cxx20-check.cpp" \
+    -o "$clab_host_tools/cxx20-check"
+"$clab_host_tools/cxx20-check"
+printf '%s\n' 'Workspace GCC 12 C++ files and constexpr-string check are ready.'
