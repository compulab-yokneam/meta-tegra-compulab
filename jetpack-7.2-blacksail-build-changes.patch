+#!/usr/bin/env bash
+set -eo pipefail
+clab_build_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
+rm -f "$clab_build_root/logs/build.exit"
+if [ "$#" -eq 0 ]; then
+    set -- edge-ai-universal-bundle
+fi
+trap 'clab_build_rc=$?; printf "%s\n" "$clab_build_rc" > "$clab_build_root/logs/build.exit"' EXIT
+cd "$clab_build_root/tegra-demo-distro"
+export MACHINE=edge-ai-nx-16g DISTRO=tegrademo
+source ./compulab-setup-env build-edge-ai-nx-16g > "$clab_build_root/logs/batch-setup.log" 2>&1
+bash "$clab_build_root/reclaim-completed-capsule-kernels.sh"
+printf 'Building batch: %s\n' "$*"
+bitbake -T 600 -k "$@" > "$clab_build_root/logs/build.log" 2>&1
+printf '%s\n' 'Batch completed successfully.'
