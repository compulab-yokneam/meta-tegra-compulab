+++ b/build-support/jetpack-7.2-blacksail/build-metadata/classes/clab-prebuilt-capsules.bbclass
@@ -0,0 +1,30 @@
+# Track successfully built capsule inputs without rescheduling their producers.
+python () {
+    if d.getVar("PN") != "edge-ai-uefi-update-capsules":
+        return
+    import os
+    if d.getVar("EDGE_AI_UEFI_LEGACY_FMP_GUIDS"):
+        bb.fatal("This prebuilt integration scope expects the twelve default capsules")
+    inputs = []
+    for mc in d.getVar("EDGE_AI_UEFI_CAPSULE_MCS").split():
+        if mc in ("edge-ai-uefi-nvidia-logo", "edge-ai-uefi-clab-logo", "edge-ai-uefi-no-logo"):
+            machine = "edge-ai-nx-16g"
+        elif mc.startswith("edge-ai-uefi-nx-8g-"):
+            machine = "edge-ai-nx-8g"
+        elif mc.startswith("edge-ai-uefi-nano-8g-"):
+            machine = "edge-ai-nano-8g"
+        elif mc.startswith("edge-ai-uefi-nano-4g-"):
+            machine = "edge-ai-nano-4g"
+        else:
+            bb.fatal("Unknown capsule producer: " + mc)
+        deploy = os.path.join(d.getVar("TOPDIR"), "tmp-mc-" + mc, "deploy/images", machine)
+        inputs.extend((os.path.join(deploy, machine + "-tegra-bl.cap"),
+                       os.path.join(deploy, d.getVar("TEGRA_FLASHVAR_UEFI_IMAGE") + ".fmp-image-type-id")))
+    if len(inputs) != 24:
+        bb.fatal("Expected twelve prebuilt capsules and their GUID files")
+    for path in inputs:
+        if not os.path.isfile(path) or os.path.getsize(path) == 0:
+            bb.fatal("Missing prebuilt capsule input: " + path)
+    d.delVarFlag("do_install", "mcdepends")
+    d.appendVarFlag("do_install", "file-checksums", " " + " ".join(path + ":True" for path in inputs))
+}
