diff --git a/build-support/jetpack-7.2-blacksail/launch-release-integration.py b/build-support/jetpack-7.2-blacksail/launch-release-integration.py
new file mode 100644
index 0000000..32e1a4b
--- /dev/null
+++ b/build-support/jetpack-7.2-blacksail/launch-release-integration.py
@@ -0,0 +1,23 @@
+#!/usr/bin/env python3
+"""Run final release assembly independently of the interactive tool session."""
+from pathlib import Path
+import json
+import subprocess
+
+root = Path(__file__).resolve().parent
+assert (root / 'logs/runtime-image.exit').read_text().strip() == '0'
+command = ['bash', str(root / 'build-batch.sh'), '-R',
+           str(root / 'batch-configs/release-integration.conf'),
+           '-c', 'deploy', 'edge-ai-universal-bundle']
+with (root / 'logs/release-driver.log').open('wb') as output:
+    process = subprocess.Popen(command, cwd=root.parent, stdin=subprocess.DEVNULL,
+                               stdout=output, stderr=subprocess.STDOUT,
+                               start_new_session=True)
+(root / 'logs/release-driver.pid').write_text(str(process.pid) + '\n')
+state_path = root / 'build-state.json'
+state = json.loads(state_path.read_text())
+state['active_exec_session'] = None
+state['active_driver_pid'] = process.pid
+state['active_phase'] = 'Four flash profiles and universal bundle integration'
+state_path.write_text(json.dumps(state, indent=2) + '\n')
+print('Release integration started; driver PID:', process.pid)
