+++ b/build-support/jetpack-7.2-blacksail/build-module-batches.sh
@@ -0,0 +1,19 @@
+#!/usr/bin/env bash
+set -eo pipefail
+clab_build_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
+trap 'clab_build_rc=$?; printf "%s\n" "$clab_build_rc" > "$clab_build_root/logs/module-batches.exit"' EXIT
+for clab_machine in edge-ai-nx-16g edge-ai-nx-8g edge-ai-nano-8g edge-ai-nano-4g; do
+    if [ "$clab_machine" = edge-ai-nx-16g ]; then
+        clab_prefix=edge-ai-uefi
+    else
+        clab_prefix=${clab_machine/edge-ai-/edge-ai-uefi-}
+    fi
+    clab_targets=()
+    for clab_variant in nvidia-logo clab-logo no-logo; do
+        clab_targets+=("mc:$clab_prefix-$clab_variant:tegra-uefi-capsules")
+    done
+    bash "$clab_build_root/build-batch.sh" -R "$clab_build_root/batch-configs/$clab_machine.conf" "${clab_targets[@]}"
+    mv "$clab_build_root/logs/build.log" "$clab_build_root/logs/$clab_machine-batch.log"
+    mv "$clab_build_root/logs/build.exit" "$clab_build_root/logs/$clab_machine-batch.exit"
+done
+printf '%s\n' 'All module firmware capsule batches completed.'
