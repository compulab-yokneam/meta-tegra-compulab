+# Requested JetPack 7.2 universal Edge-AI build.
+require conf/include/edge-ai-universal-bundle.inc
+BB_NUMBER_THREADS = "16"
+BB_NUMBER_PARSE_THREADS = "32"
+PARALLEL_MAKE = "-j 16"
+INHERIT += "rm_work"
+
+# Node.js 24 requires GCC >= 12.2; use the matching workspace C++ tools.
+BUILD_CC:pn-nodejs-native = "/usr/bin/gcc-12"
+BUILD_CXX:pn-nodejs-native = "${TOPDIR}/../../host-tools/bin/g++-12"
+BUILD_CPP:pn-nodejs-native = "/usr/bin/gcc-12 -E"
+
+# Point Clang's libc++ bootstrap at the complete matching GCC 12 installation.
+CXXFLAGS:append:pn-libcxx-native = " --gcc-install-dir=${TOPDIR}/../../host-tools/usr/lib/gcc/x86_64-linux-gnu/12"
diff --git a/build-support/jetpack-7.2-blacksail/monitor-build.py b/build-support/jetpack-7.2-blacksail/monitor-build.py
new file mode 100644
index 0000000..6e473ba
--- /dev/null
+++ b/build-support/jetpack-7.2-blacksail/monitor-build.py
@@ -0,0 +1,33 @@
+#!/usr/bin/env python3
+from pathlib import Path
+from collections import Counter
+import re
+import sys
+
+root = Path(__file__).resolve().parent
+log = root / 'logs/build.log'
+if not log.exists():
+    print('Task log pending.')
+    raise SystemExit(0)
+lines = log.read_text(errors='replace').splitlines()
+active = Counter()
+for line in lines:
+    match = re.match(r'NOTE: recipe (.+): task ([^:]+): (Started|Succeeded|Failed)$', line)
+    if match:
+        active[match.group(1) + ':' + match.group(2)] += 1 if match.group(3) == 'Started' else -1
+for key, count in active.items():
+    if count > 0 and not key.endswith('_setscene'):
+        print('Active:', key, count)
+work = root / 'tegra-demo-distro/build-edge-ai-nx-16g/tmp-mc-edge-ai-runtime/work/x86_64-linux'
+for recipe in sys.argv[1:]:
+    for task_log in work.glob(f'{recipe}/*/temp/log.do_compile'):
+        matches = re.findall(r'^\[(\d+)/(\d+)\]', task_log.read_text(errors='replace'), re.M)
+        if matches:
+            print(recipe, 'build units:', '/'.join(matches[-1]))
+failed = [line for line in lines if line.startswith('ERROR: Task ')]
+print('Failed task count:', len(failed))
+for line in failed[-3:]:
+    print(line)
+status_lines = [line for line in lines if not line.startswith('WARNING:')]
+print('\n'.join(status_lines[-3:]))
+print('Warning messages:', sum(line.startswith('WARNING:') for line in lines))
diff --git a/build-support/jetpack-7.2-blacksail/reclaim-completed-capsule-kernels.sh b/build-support/jetpack-7.2-blacksail/reclaim-completed-capsule-kernels.sh
new file mode 100644
index 0000000..9563454
--- /dev/null
+++ b/build-support/jetpack-7.2-blacksail/reclaim-completed-capsule-kernels.sh
@@ -0,0 +1,45 @@
+#!/usr/bin/env bash
+set -eo pipefail
+clab_build_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
+clab_free_bytes=$(df --output=avail -B1 "$clab_build_root" | tail -1 | tr -d ' ')
+if (( clab_free_bytes >= 90 * 1024 * 1024 * 1024 )); then
+    exit 0
+fi
+clab_mcs=()
+clab_kernel_targets=()
+clab_completed_machines=()
+clab_capsule_files=()
+for clab_machine in edge-ai-nx-16g edge-ai-nx-8g edge-ai-nano-8g edge-ai-nano-4g; do
+    clab_receipt="$clab_build_root/logs/$clab_machine-batch.exit"
+    if [[ ! -f "$clab_receipt" || -f "$clab_build_root/logs/$clab_machine-capsule-kernels.cleaned" ]]; then
+        continue
+    fi
+    [[ $(cat "$clab_receipt") == 0 ]] || continue
+    clab_completed_machines+=("$clab_machine")
+    if [[ "$clab_machine" == edge-ai-nx-16g ]]; then
+        clab_prefix=edge-ai-uefi
+    else
+        clab_prefix=${clab_machine/edge-ai-/edge-ai-uefi-}
+    fi
+    for clab_variant in nvidia-logo clab-logo no-logo; do
+        clab_mc="$clab_prefix-$clab_variant"
+        clab_mcs+=("$clab_mc")
+        clab_kernel_targets+=("mc:$clab_mc:linux-yocto")
+        clab_capsule_files+=("$clab_build_root/tegra-demo-distro/build-edge-ai-nx-16g/tmp-mc-$clab_mc/deploy/images/$clab_machine/$clab_machine-tegra-bl.cap")
+    done
+done
+(( ${#clab_kernel_targets[@]} > 0 )) || exit 0
+clab_scope="$clab_build_root/batch-configs/completed-capsule-kernels.conf"
+printf 'unset BBMULTICONFIG\nBBMULTICONFIG = "%s"\n' "${clab_mcs[*]}" > "$clab_scope"
+clab_cleanup_log="$clab_build_root/logs/capsule-kernel-clean-$(date +%s).log"
+printf 'Reclaiming retained kernel work from completed capsule batches: %s\n' "${clab_completed_machines[*]}"
+# clean keeps the sstate cache and download cache. Capsule deploy files are
+# produced by a separate recipe and remain available for runtime assembly.
+bitbake -T 600 -R "$clab_scope" -c clean "${clab_kernel_targets[@]}" > "$clab_cleanup_log" 2>&1
+for clab_capsule in "${clab_capsule_files[@]}"; do
+    [[ -s "$clab_capsule" ]] || { printf 'Completed capsule is missing: %s\n' "$clab_capsule" >&2; exit 2; }
+done
+for clab_machine in "${clab_completed_machines[@]}"; do
+    printf '%s\n' "$clab_cleanup_log" > "$clab_build_root/logs/$clab_machine-capsule-kernels.cleaned"
+done
+df -h "$clab_build_root"
diff --git a/build-support/jetpack-7.2-blacksail/record-capsule-inputs.py b/build-support/jetpack-7.2-blacksail/record-capsule-inputs.py
new file mode 100755
index 0000000..5ef62b1
--- /dev/null
+++ b/build-support/jetpack-7.2-blacksail/record-capsule-inputs.py
@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+"""Record freshly built capsule/GUID inputs without recording build success."""
+from pathlib import Path
+import hashlib
+import json
+import re
+
+
+root = Path(__file__).resolve().parent
+build = root / "tegra-demo-distro/build-edge-ai-nx-16g"
+expected_guid = "bf0d4599-20d4-414e-b2c5-3595b1cda402"
+variants = ("nvidia-logo", "clab-logo", "no-logo")
+producers = (
+    ("edge-ai-uefi", "edge-ai-nx-16g"),
+    ("edge-ai-uefi-nx-8g", "edge-ai-nx-8g"),
+    ("edge-ai-uefi-nano-8g", "edge-ai-nano-8g"),
+    ("edge-ai-uefi-nano-4g", "edge-ai-nano-4g"),
+)
+records = []
+for prefix, machine in producers:
+    for variant in variants:
+        mc = prefix + "-" + variant
+        deploy = build / ("tmp-mc-" + mc) / "deploy/images" / machine
+        capsule = deploy / (machine + "-tegra-bl.cap")
+        guid_file = deploy / "uefi_t23x_general.fmp-image-type-id"
+        for path in (capsule, guid_file):
+            if not path.is_file() or path.stat().st_size == 0:
+                raise SystemExit("Missing or empty capsule input: " + str(path))
+        guid = guid_file.read_text().strip().lower()
+        if not re.fullmatch(r"[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}", guid):
+            raise SystemExit("Invalid GUID in " + str(guid_file))
+        if guid != expected_guid:
+            raise SystemExit("Unexpected GUID in " + str(guid_file) + ": " + guid)
+        sha = hashlib.sha256()
+        with capsule.open("rb") as stream:
+            while chunk := stream.read(1024 * 1024):
+                sha.update(chunk)
+        records.append({
+            "mc": mc,
+            "capsule": str(capsule),
+            "sha256": sha.hexdigest(),
+            "guid_file": str(guid_file),
+            "guid": guid,
+        })
+
+receipt = root / "logs/prebuilt-capsule-inputs.json"
+receipt.parent.mkdir(parents=True, exist_ok=True)
+receipt.write_text(json.dumps(records, indent=2) + "\n")
+print("Recorded twelve current capsule/GUID inputs:", receipt)
