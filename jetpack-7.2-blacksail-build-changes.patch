diff --git a/build-support/jetpack-7.2-blacksail/verify-release.py b/build-support/jetpack-7.2-blacksail/verify-release.py
new file mode 100644
index 0000000..74fe17e
--- /dev/null
+++ b/build-support/jetpack-7.2-blacksail/verify-release.py
@@ -0,0 +1,125 @@
+#!/usr/bin/env python3
+"""Read-only checks of the release archive and its shared root filesystem."""
+from pathlib import Path
+import hashlib
+import json
+import re
+import subprocess
+import tarfile
+import tempfile
+
+root = Path(__file__).resolve().parent
+build = root / 'tegra-demo-distro/build-edge-ai-nx-16g'
+deploy = build / 'tmp/deploy/images/edge-ai-nx-16g'
+archives = list(deploy.glob('demo-image-weston-edge-ai-universal-*.tar.zst'))
+assert len(archives) == 1, archives
+archive = archives[0]
+checksum_file = Path(str(archive) + '.sha256')
+expected_hash, expected_name = checksum_file.read_text().strip().split(maxsplit=1)
+assert expected_name.lstrip('*') == archive.name
+
+def digest(stream):
+    h = hashlib.sha256()
+    while chunk := stream.read(16 * 1024 * 1024):
+        h.update(chunk)
+    return h.hexdigest()
+
+with archive.open('rb') as stream:
+    archive_hash = digest(stream)
+assert archive_hash == expected_hash, 'Archive checksum mismatch'
+print('Archive SHA256 verified.', flush=True)
+
+prefix = archive.name.removesuffix('.tar.zst')
+skus = {'edge-ai-nx-16g': '0000', 'edge-ai-nx-8g': '0001',
+        'edge-ai-nano-8g': '0003', 'edge-ai-nano-4g': '0004'}
+flashvars = {}
+links = {}
+runtime_hash = None
+launcher = False
+members = 0
+proc = subprocess.Popen(['zstd', '-dc', str(archive)], stdout=subprocess.PIPE)
+try:
+    with tarfile.open(fileobj=proc.stdout, mode='r|') as tar:
+        for member in tar:
+            members += 1
+            if member.name == prefix + '/runtime/demo-image-weston.ext4':
+                assert member.isfile() and member.size > 0
+                runtime_hash = digest(tar.extractfile(member))
+            elif member.name == prefix + '/flash-edge-ai.sh':
+                launcher = member.isfile() and bool(member.mode & 0o111)
+                subprocess.run(['bash', '-n'], input=tar.extractfile(member).read(), check=True)
+            for machine in skus:
+                profile = prefix + '/profiles/' + machine + '/'
+                if member.name == profile + 'flashvars':
+                    flashvars[machine] = tar.extractfile(member).read().decode()
+                elif member.name == profile + 'edge-ai-flash-profile.ext4':
+                    assert member.issym()
+                    links[machine] = member.linkname
+    assert proc.wait() == 0, 'zstd decompression failed'
+finally:
+    proc.stdout.close()
+    if proc.poll() is None:
+        proc.kill()
+        proc.wait()
+assert launcher and runtime_hash
+for machine, sku in skus.items():
+    assert f'CHECK_BOARDSKU="${{CHECK_BOARDSKU-{sku}}}"' in flashvars[machine]
+    assert links[machine] == '../../runtime/demo-image-weston.ext4'
+    subprocess.run(['bash', '-n'], input=flashvars[machine], text=True, check=True)
+print('All four profile SKUs and shared rootfs links verified.', flush=True)
+
+runtime_deploy = build / 'tmp-mc-edge-ai-runtime/deploy/images/edge-ai-nx-16g'
+image = runtime_deploy / 'demo-image-weston-edge-ai-nx-16g.rootfs.ext4'
+with image.open('rb') as stream:
+    assert digest(stream) == runtime_hash, 'Bundled rootfs differs from deployed rootfs'
+
+def debugfs(command):
+    result = subprocess.run(['debugfs', '-R', command, str(image)],
+                            check=True, text=True, capture_output=True)
+    return result.stdout
+
+capsule_dir = '/usr/share/compulab/uefi-update-capsules'
+capsule_readme = debugfs('cat ' + capsule_dir + '/README.txt')
+assert 'Payload L4T release: 39.2.1' in capsule_readme
+sum_lines = debugfs('cat ' + capsule_dir + '/SHA256SUMS').strip().splitlines()
+expected_capsules = {f'{m}-uefi-{v}.cap' for m in skus
+                     for v in ('nvidia-logo', 'clab-logo', 'no-logo')}
+capsule_hashes = {}
+for line in sum_lines:
+    sha, name = line.split(maxsplit=1)
+    assert re.fullmatch('[0-9a-f]{64}', sha)
+    capsule_hashes[name.lstrip('*')] = sha
+assert set(capsule_hashes) == expected_capsules
+for record in json.loads((root / 'logs/prebuilt-capsule-inputs.json').read_text()):
+    machine = Path(record['capsule']).name.removesuffix('-tegra-bl.cap')
+    variant = next(v for v in ('nvidia-logo', 'clab-logo', 'no-logo') if record['mc'].endswith(v))
+    assert capsule_hashes[f'{machine}-uefi-{variant}.cap'] == record['sha256']
+listing = debugfs('ls -l ' + capsule_dir)
+assert len(re.findall(r'\S+\.cap\b', listing)) == 12
+with tempfile.TemporaryDirectory(prefix='compulab-release-check-', dir='/tmp') as temp:
+    for name, sha in capsule_hashes.items():
+        target = Path(temp) / name
+        debugfs(f'dump {capsule_dir}/{name} {target}')
+        with target.open('rb') as stream:
+            assert digest(stream) == sha, name
+helper = debugfs('cat ' + capsule_dir + '/apply-uefi-capsule')
+assert helper.startswith('#!')
+subprocess.run(['bash', '-n'], input=helper, text=True, check=True)
+assert re.search(r'Mode:\s+0755', debugfs('stat /usr/sbin/edge-ai-uefi-update'))
+subprocess.run(['bash', '-n'], input=debugfs('cat /usr/sbin/edge-ai-uefi-update'), text=True, check=True)
+print('Twelve installed capsules, their SHA256 sums and updater verified.', flush=True)
+
+manifest = runtime_deploy / 'demo-image-weston-edge-ai-nx-16g.rootfs.manifest'
+packages = manifest.read_text().splitlines()
+selected = [p for p in packages if re.match(r'(firefox|cuda-cudart|nvidia-kernel-oot|kernel-image|edge-ai-universal-runtime|edge-ai-uefi-update-capsules)( |-|$)', p)]
+assert any(p.startswith('firefox ') for p in selected)
+assert any(p.startswith('cuda-cudart ') for p in selected)
+assert any(p.startswith('edge-ai-universal-runtime ') for p in selected)
+assert any(p.startswith('edge-ai-uefi-update-capsules ') for p in selected)
+report = {'archive': str(archive), 'archive_bytes': archive.stat().st_size,
+          'sha256': archive_hash, 'rootfs_sha256': runtime_hash,
+          'archive_members': members, 'profiles': skus,
+          'capsules': len(capsule_hashes), 'l4t': '39.2.1',
+          'selected_manifest_packages': selected, 'hardware_boot_tested': False}
+(root / 'logs/release-verification.json').write_text(json.dumps(report, indent=2) + '\n')
+print(json.dumps(report, indent=2))
