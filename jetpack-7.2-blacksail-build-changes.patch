+#!/usr/bin/env python3
+"""Relocate this build's download cache while BitBake is idle."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parent
+source = root / 'tegra-demo-distro/build-edge-ai-nx-16g/downloads'
+if source.is_symlink():
+    print('Download cache is already at', source.resolve())
+else:
+    if not source.is_dir():
+        raise SystemExit(f'Download cache does not exist: {source}')
+    destination = Path(tempfile.mkdtemp(prefix='compulab-jetpack-7.2-downloads-', dir='/tmp')) / 'downloads'
+    subprocess.run(['mv', '--', str(source), str(destination)], check=True)
+    try:
+        source.symlink_to(destination, target_is_directory=True)
+    except BaseException:
+        subprocess.run(['mv', '--', str(destination), str(source)], check=True)
+        raise
+    (root / 'logs/download-cache-location.txt').write_text(f'{source}\n{destination}\n')
+    print('Download cache relocated to', destination)
diff --git a/build-support/jetpack-7.2-blacksail/replay-crate-recovery.py b/build-support/jetpack-7.2-blacksail/replay-crate-recovery.py
new file mode 100755
index 0000000..83d708b
--- /dev/null
+++ b/build-support/jetpack-7.2-blacksail/replay-crate-recovery.py
@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+"""Replay the checksum-verified alternate static.crates.io download recovery.
+
+Packaging of a manual build operation, not a change to BitBake's fetcher.
+Run only while the build is idle. --list-only does not access the network.
+"""
+from pathlib import Path
+import argparse
+import hashlib
+import re
+import urllib.request
+
+root = Path(__file__).resolve().parent
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--list-only', action='store_true')
+parser.add_argument('--crate', help='Recover only this name-version entry')
+args = parser.parse_args()
+recipe = root / 'tegra-demo-distro/layers/meta-browser/meta-firefox/recipes-devtools/wasm-tools/wasm-tools-crates.inc'
+text = recipe.read_text()
+urls = re.findall(r'crate://crates\.io/([A-Za-z0-9_-]+)/([A-Za-z0-9.+_-]+)', text)
+checksums = dict(re.findall(r'SRC_URI\[([^\]]+)\.sha256sum\]\s*=\s*"([0-9a-f]{64})"', text))
+selected = [(name, version) for name, version in urls
+            if args.crate is None or f'{name}-{version}' == args.crate]
+if not selected:
+    raise SystemExit('No matching crate in the pinned wasm-tools recipe')
+downloads = root / 'tegra-demo-distro/build-edge-ai-nx-16g/downloads'
+if not args.list_only:
+    downloads.mkdir(parents=True, exist_ok=True)
+
+def sha256(path):
+    digest = hashlib.sha256()
+    with path.open('rb') as stream:
+        while chunk := stream.read(1024 * 1024):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+for name, version in selected:
+    key = f'{name}-{version}'
+    expected = checksums[key]
+    url = f'https://static.crates.io/crates/{name}/{key}.crate'
+    if args.list_only:
+        print(key, expected, url)
+        continue
+    target = downloads / (key + '.crate')
+    if target.exists():
+        if sha256(target) != expected:
+            raise SystemExit(f'Existing crate checksum mismatch: {target}')
+        print('Already verified:', target.name)
+        continue
+    temporary = downloads / (key + '.crate.recovery-part')
+    try:
+        with urllib.request.urlopen(url, timeout=180) as response, temporary.open('wb') as output:
+            while chunk := response.read(1024 * 1024):
+                output.write(chunk)
+        if sha256(temporary) != expected:
+            raise SystemExit(f'Downloaded crate checksum mismatch: {key}')
+        temporary.replace(target)
+    finally:
+        temporary.unlink(missing_ok=True)
+    print('Recovered and verified:', target.name)
