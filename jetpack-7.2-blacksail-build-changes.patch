+#!/usr/bin/env bash
+set -eo pipefail
+
+clab_build_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
+clab_build_target=${1:-edge-ai-universal-bundle}
+mkdir -p "$clab_build_root/logs"
+trap 'clab_build_rc=$?; printf "%s\n" "$clab_build_rc" > "$clab_build_root/logs/build.exit"' EXIT
+
+cd "$clab_build_root/tegra-demo-distro"
+export MACHINE=edge-ai-nx-16g DISTRO=tegrademo
+source ./compulab-setup-env build-edge-ai-nx-16g
+
+printf '%s\n' 'Checking all metadata...'
+bitbake -p > "$clab_build_root/logs/parse.log" 2>&1
+printf 'Building %s...\n' "$clab_build_target"
+bitbake -k "$clab_build_target" > "$clab_build_root/logs/build.log" 2>&1
+printf '%s\n' 'Build completed successfully.'
