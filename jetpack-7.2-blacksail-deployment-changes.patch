+clab_metadata=$(python3 - "$clab_deploy_root/deployment-readiness.json" <<'PYTHON'
+import json, re, sys
+with open(sys.argv[1]) as stream:
+    state = json.load(stream)
+target = state.get('flash_target', {})
+if (not state.get('recovery_eeprom_probe_completed')
+        or state.get('machine') != 'edge-ai-nx-16g'
+        or target.get('board_id') != '3767' or target.get('board_sku') != '0000'):
     raise SystemExit('The NX 16GB recovery check must pass before deployment')
+if not re.fullmatch('[0-9a-f]{8}', target.get('usb_serial', '')):
+    raise SystemExit('Missing checked USB serial for the automount guard')
 print(state['deployment_directory'])
+print(target['usb_serial'])
 PYTHON
 )
+mapfile -t clab_fields <<< "$clab_metadata"
+[ "${#clab_fields[@]}" -eq 2 ] || exit 1
+clab_bundle=${clab_fields[0]}
+clab_usb_serial=${clab_fields[1]}
+exec 9> "$clab_deploy_root/deployment.lock"
+flock --nonblock 9 || { printf '%s\n' 'Another deployment is already running.' >&2; exit 1; }
+
+clab_rule=
+clab_cleanup() {
+    local clab_rc=$?
+    trap - EXIT
+    if [ -n "$clab_rule" ]; then
+        rm -f -- "$clab_rule"
+        udevadm control --reload-rules || printf '%s\n' 'Could not reload udev rules after cleanup.' >&2
+    fi
+    exit "$clab_rc"
+}
+trap clab_cleanup EXIT
+trap 'exit 130' INT
+trap 'exit 143' TERM
+
+# Match only this board's flashing gadget. Explicit UDisks mounts used by
+# initrd-flash remain available, while desktop automount is suppressed.
+mkdir -p /run/udev/rules.d
+clab_rule=$(mktemp --suffix=.rules "/run/udev/rules.d/99-zz-clab-edge-ai-${clab_usb_serial}-XXXXXX")
+printf 'SUBSYSTEM=="block", SUBSYSTEMS=="usb", ATTRS{idVendor}=="1d6b", ATTRS{idProduct}=="0104", ATTRS{serial}=="%s", ENV{UDISKS_IGNORE}="1", ENV{UDISKS_AUTO}="0"\n' \
+    "$clab_usb_serial" > "$clab_rule"
+chmod 0644 "$clab_rule"
+udevadm control --reload-rules
+printf 'Temporary automount guard enabled for Edge-AI USB serial %s.\n' "$clab_usb_serial"
+
+python3 - "$clab_deploy_root/deployment-readiness.json" <<'PYTHON'
+from pathlib import Path
+import json, sys
+path = Path(sys.argv[1])
+state = json.loads(path.read_text())
+state.update(status='flashing', deployment_started=True, deployment_completed=False)
+path.write_text(json.dumps(state, indent=2) + '\n')
+PYTHON
 cd -- "$clab_bundle"
 printf '%s\n' 'Deploying JetPack 7.2 / L4T R39.2.1: replaces board NVMe contents and updates QSPI boot firmware.'
-exec sudo ./flash-edge-ai.sh
+clab_flash_rc=0
+./flash-edge-ai.sh || clab_flash_rc=$?
+python3 - "$clab_deploy_root/deployment-readiness.json" "$clab_flash_rc" <<'PYTHON'
+from pathlib import Path
+import json, sys
+path = Path(sys.argv[1])
+state = json.loads(path.read_text())
+rc = int(sys.argv[2])
+state.update(status='flash_completed_pending_boot_check' if rc == 0 else 'flash_failed',
+             flash_exit_code=rc, deployment_completed=rc == 0)
+path.write_text(json.dumps(state, indent=2) + '\n')
+PYTHON
+exit "$clab_flash_rc"
