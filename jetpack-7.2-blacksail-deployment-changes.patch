+#!/usr/bin/env python3
+"""Verify the selected Jetson USB disk and unmount it before GPT writes."""
+from pathlib import Path
+import json
+import os
+import stat
+import subprocess
+import sys
+
+
+def run(arguments):
+    return subprocess.run(arguments, check=True, text=True, capture_output=True)
+
+
+def identify_target(device, expected, sys_root=Path('/sys')):
+    name = Path(device).name
+    block = sys_root / 'class/block' / name
+    if not block.exists() or (block / 'partition').exists():
+        raise RuntimeError('Expected a whole USB disk: ' + str(device))
+    ancestry = (block / 'device').resolve()
+    usb = next((parent for parent in (ancestry, *ancestry.parents)
+                if (parent / 'idVendor').is_file() and (parent / 'idProduct').is_file()), None)
+    if usb is None:
+        raise RuntimeError('Refusing a disk without a USB parent: ' + str(device))
+    values = {key: (usb / key).read_text().strip()
+              for key in ('idVendor', 'idProduct', 'serial')}
+    if values != {'idVendor': '1d6b', 'idProduct': '0104', 'serial': expected['usb_serial']}:
+        raise RuntimeError('USB disk identity does not match the checked Edge-AI: ' + str(values))
+    vendor = (block / 'device/vendor').read_text().strip()
+    if vendor != 'nvme0n1':
+        raise RuntimeError('Expected the board NVMe export, found: ' + vendor)
+    sectors = int((block / 'size').read_text().strip())
+    if sectors != expected['disk_sectors']:
+        raise RuntimeError(f'Board NVMe capacity changed: {sectors} sectors')
+    return block
+
+
+def properties(output):
+    return dict(line.split('=', 1) for line in output.splitlines() if '=' in line)
+
+
+def mounts_for(device, runner=run):
+    result = runner(['findmnt', '--json', '--list', '--source', device, '--output', 'TARGET'])
+    return [entry['target'] for entry in json.loads(result.stdout).get('filesystems', [])]
+
+
+def prepare(device, expected, sys_root=Path('/sys'), runner=run):
+    identify_target(device, expected, sys_root)
+    identity = runner(['udevadm', 'info', '--query=property', '--name=' + str(device)])
+    props = properties(identity.stdout)
+    if props.get('UDISKS_IGNORE') != '1' or props.get('UDISKS_AUTO') != '0':
+        raise RuntimeError('Scoped automount guard is missing; use deploy-edge-ai.sh')
+    result = runner(['lsblk', '--noheadings', '--raw', '--paths', '--output', 'NAME', str(device)])
+    devices = result.stdout.splitlines()
+    if not devices or devices[0] != str(device):
+        raise RuntimeError('Unexpected lsblk disk tree: ' + result.stdout)
+    for child in reversed(devices):
+        try:
+            targets = mounts_for(child, runner)
+        except subprocess.CalledProcessError as error:
+            if error.returncode != 1 or error.stderr.strip():
+                raise
+            targets = []
+        for target in targets:
+            print(f'Unmounting checked board disk: {child} at {target}', flush=True)
+            runner(['umount', '--', target])
+    runner(['udevadm', 'settle', '--timeout=10'])
+    identify_target(device, expected, sys_root)
+    for child in devices:
+        try:
+            targets = mounts_for(child, runner)
+        except subprocess.CalledProcessError as error:
+            if error.returncode != 1 or error.stderr.strip():
+                raise
+            targets = []
+        if targets:
+            raise RuntimeError(f'Refusing GPT writes while {child} is mounted: {targets}')
+    print(f'Checked Edge-AI NVMe {device}: identity matches, automount blocked, no mounts', flush=True)
+
+
+def main():
+    if len(sys.argv) != 2:
+        raise RuntimeError('Usage: prepare-flash-target.py /dev/USB_DISK')
+    device = str(Path(sys.argv[1]).resolve())
+    if os.geteuid() != 0:
+        raise RuntimeError('Flash target preparation must run as root')
+    if not stat.S_ISBLK(os.stat(device).st_mode):
+        raise RuntimeError('Expected a block device: ' + device)
+    expected = json.loads(Path(__file__).with_name('clab-flash-target.json').read_text())
+    prepare(device, expected)
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (RuntimeError, OSError, subprocess.CalledProcessError, ValueError) as error:
+        print('ERR: flash target preparation failed: ' + str(error), file=sys.stderr)
+        if isinstance(error, subprocess.CalledProcessError) and error.stderr:
+            print(error.stderr.strip(), file=sys.stderr)
+        raise SystemExit(1)
