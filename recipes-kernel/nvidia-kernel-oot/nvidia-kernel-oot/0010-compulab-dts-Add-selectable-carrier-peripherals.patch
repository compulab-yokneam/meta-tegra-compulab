diff --git a/hardware/nvidia/t23x/nv-public/overlay/tegra234-camera-HDMI-rk628.dts b/hardware/nvidia/t23x/nv-public/overlay/tegra234-camera-HDMI-rk628.dts
new file mode 100644
--- /dev/null
+++ b/hardware/nvidia/t23x/nv-public/overlay/tegra234-camera-HDMI-rk628.dts
@@ -0,0 +1,132 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/tegra234-p3767-0000-common.h>
+
+#define HDMI_RESET  TEGRA234_MAIN_GPIO(AC, 6)
+#define RK628CSI_EN "okay"
+
+/ {
+    overlay-name = "RK628-HDMI-CSI-4Lane-Port2";
+    jetson-header-name = "Jetson 22pin CSI Connector";
+    compatible = JETSON_COMPATIBLE_P3768;
+
+    fragment@0 {
+        target-path = "/";
+        __overlay__ {
+            tegra-capture-vi {
+                num-channels = <1>;
+                status = RK628CSI_EN;
+                ports {
+                    #address-cells = <1>;
+                    #size-cells = <0>;
+                    port@0 {
+                        status = RK628CSI_EN;
+                        reg = <0>;
+                        rk628_vi_in0: endpoint {
+                            status = RK628CSI_EN;
+                            port-index = <2>;
+                            bus-width = <4>;
+                            remote-endpoint = <&rk628_nvcsi_out>;
+                        };
+                    };
+                };
+            };
+
+            bus@0 {
+                host1x@13e00000 {
+                    nvcsi@15a00000 {
+                        num-channels = <1>;
+                        #address-cells = <1>;
+                        #size-cells = <0>;
+                        status = RK628CSI_EN;
+                        channel@0 {
+                            status = RK628CSI_EN;
+                            reg = <0>;
+                            discontinuous_clk = "no";
+                            ports {
+                                #address-cells = <1>;
+                                #size-cells = <0>;
+                                port@0 {
+                                    status = RK628CSI_EN;
+                                    reg = <0>;
+                                    rk628_nvcsi_in: endpoint {
+                                        status = RK628CSI_EN;
+                                        port-index = <2>;
+                                        bus-width = <4>;
+                                        /* This must match the endpoint label in rk628_csi */
+                                        remote-endpoint = <&hdmiin_out1>;
+                                    };
+                                };
+                                port@1 {
+                                    status = RK628CSI_EN;
+                                    reg = <1>;
+                                    rk628_nvcsi_out: endpoint {
+                                        remote-endpoint = <&rk628_vi_in0>;
+                                    };
+                                };
+                            };
+                        };
+                    };
+                };
+
+                i2c@3180000 {
+                    #address-cells = <1>;
+                    #size-cells = <0>;
+                    status = RK628CSI_EN;
+                    rk628_csi: rk628_csi@50{
+                        reg = <0x50>;
+                        compatible = "rockchip,rk628-csi-v4l2";
+                        status = RK628CSI_EN;
+                        continues-clk = <1>;
+                        reset-gpios = <&gpio HDMI_RESET GPIO_ACTIVE_HIGH>;
+                        rk628-hdmi-in;
+                        rk628-csi-out;
+                        rockchip,camera-module-index = <0>;
+                        rockchip,camera-module-facing = "back";
+                        rockchip,camera-module-name = "HDMI-MIPI2";
+                        rockchip,camera-module-lens-name = "RK628-CSI";
+
+                        port {
+                            hdmiin_out1: endpoint {
+                                status = RK628CSI_EN;
+                                remote-endpoint = <&rk628_nvcsi_in>;
+                                data-lanes = <1 2 3 4>;
+                                bus-type = <4>;
+                           };
+                        };
+                    };
+                };
+            };
+
+            tegra-camera-platform {
+                compatible = "nvidia,tegra-camera-platform";
+                num_csi_lanes = <4>;
+                max_lane_speed = <2500000>;
+                min_bits_per_pixel = <16>;
+                vi_peak_byte_per_pixel = <3>;
+                vi_bw_margin_pct = <25>;
+                isp_peak_byte_per_pixel = <3>;
+                isp_bw_margin_pct = <25>;
+                status = RK628CSI_EN;
+
+                modules {
+                    module0 {
+                        status = RK628CSI_EN;
+                        badge = "rk628_hdmi_csi";
+                        drivernode0 {
+                            /* Declare PCL support driver (classically known as guid)  */
+                            pcl_id = "v4l2_sensor";
+                            /* Driver v4l2 device name */
+                            devname = "rk628-csi 2-0050";
+                            /* Declare the device-tree hierarchy to driver instance */
+                            proc-device-tree = "/proc/device-tree/bus@0/i2c@3180000/rk628_csi@50";
+                            sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/i2c@3180000/rk628_csi@50";
+                        };
+                    };
+                };
+            };
+        };
+    };
+};
diff --git a/hardware/nvidia/t23x/nv-public/overlay/tegra234-camera-PAL-adv280-m.dts b/hardware/nvidia/t23x/nv-public/overlay/tegra234-camera-PAL-adv280-m.dts
new file mode 100644
--- /dev/null
+++ b/hardware/nvidia/t23x/nv-public/overlay/tegra234-camera-PAL-adv280-m.dts
@@ -0,0 +1,137 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/tegra234-p3767-0000-common.h>
+
+/ {
+    overlay-name = "ADV7280-I2C-PAL";
+    jetson-header-name = "Jetson 22pin CSI Connector";
+    compatible = JETSON_COMPATIBLE_P3768;
+
+    fragment@0 {
+        target-path = "/";
+        __overlay__ {
+            tegra-capture-vi  {
+                status = "okay";
+                num-channels = <1>;
+                ports {
+                    #address-cells = <1>;
+                    #size-cells = <0>;
+                    port@0{
+                        status = "okay";
+                        reg = <0>;
+                        adv7280_vi_in0: endpoint {
+                            status = "okay";
+                            port-index = <0>;  // MIPI0 -> CSI-A
+                            bus-width = <1>;   // Use CSI-A only
+                            remote-endpoint = <&adv7280_csi_out0>;
+                        };
+                    };
+                };
+            };
+
+            bus@0 {
+                host1x@13e00000 {
+                    nvcsi@15a00000 {
+                        num-channels = <1>;
+                        #address-cells = <1>;
+                        #size-cells = <0>;
+                        status = "okay";
+                        channel@0 {
+                            reg = <0>;
+                            status = "okay";
+                            discontinuous_clk = "no";
+                            ports {
+                                #address-cells = <1>;
+                                #size-cells = <0>;
+                                status = "okay";
+                                port@0 {
+                                    status = "okay";
+                                    reg = <0>;
+                                    adv7280_csi_in0: endpoint@0 {
+                                        status = "okay";
+                                        port-index = <0>;
+                                        bus-width = <1>;
+                                        remote-endpoint = <&adv7280_i2c_out0>;
+                                    };
+                                };
+                                port@1 {
+                                    status = "okay";
+                                    reg = <1>;
+                                    adv7280_csi_out0: endpoint@1 {
+                                        status = "okay";
+                                        remote-endpoint = <&adv7280_vi_in0>;
+                                    };
+                                };
+                            };
+                        };
+                    };
+                };
+
+                i2c@3180000 {
+                    status = "okay";
+                    /* Node name must be simple, compatible must be exact */
+                    adv7280@20 {
+                        compatible = "adi,adv7280-m";
+                        reg = <0x20>;
+                        status = "okay";
+                        /* NVIDIA PCL matching fields */
+                        devnode = "video0";
+                        physical_w = "4.713";
+                        physical_h = "3.494";
+                        sensor_model = "adv7280-m";
+                        use_sensor_mode_id = "false";
+                        ports {
+                            #address-cells = <1>;
+                            #size-cells = <0>;
+                            port@0 {
+                                reg = <0>;
+                                adv7280_i2c_out0: endpoint {
+                                    status = "okay";
+                                    port-index = <0>;
+                                    bus-width = <1>;
+                                    remote-endpoint = <&adv7280_csi_in0>;
+                                };
+                            };
+                        };
+                    };
+                };
+            };
+
+            tegra-camera-platform {
+                compatible = "nvidia,tegra-camera-platform";
+                num_csi_lanes = <1>;
+                max_lane_speed = <1500000>;
+                min_bits_per_pixel = <10>;
+                vi_peak_byte_per_pixel = <2>;
+                vi_bw_margin_pct = <25>;
+                max_pixel_rate = <240000>;
+                isp_peak_byte_per_pixel = <5>;
+                isp_bw_margin_pct = <25>;
+                /*
+                * The general guideline for naming badge_info contains 3 parts, and is as follows,
+                * The first part is the camera_board_id for the module; if the module is in a FFD
+                * platform, then use the platform name for this part.
+                * The second part contains the position of the module, ex. rear or front.
+                * The third part contains the last 6 characters of a part number which is found
+                * in the module's specsheet from the vender.
+                */
+                modules {
+                    module0 {
+                        status = "okay";
+                        badge = "front_ADV7280";
+                        position = "front";
+                        orientation = "1";
+                        drivernode0 {
+                            status = "okay";
+                            pcl_id = "v4l2_sensor";
+                            devname = "adv7280 2-0020";
+                            sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/i2c@3180000/adv7280@20";
+                        };
+                    };
+                };
+            };
+        };
+    };
+};
diff --git a/hardware/nvidia/t23x/nv-public/overlay/tegra234-edge-ai-eb-edgerpi4.dts b/hardware/nvidia/t23x/nv-public/overlay/tegra234-edge-ai-eb-edgerpi4.dts
new file mode 100644
--- /dev/null
+++ b/hardware/nvidia/t23x/nv-public/overlay/tegra234-edge-ai-eb-edgerpi4.dts
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/dts-v1/;
+/plugin/;
+
+/ {
+	overlay-name = "CompuLab EB-EdgeRPI4 GPIO expander and RTC";
+	compatible = "nvidia,tegra234";
+};
+
+&hdr40_i2c1 {
+	status = "okay";
+	#address-cells = <1>;
+	#size-cells = <0>;
+	edge_ai_pca9555: gpio@20 {
+		compatible = "nxp,pca9555";
+		reg = <0x20>;
+		gpio-controller;
+		#gpio-cells = <2>;
+		status = "okay";
+	};
+	edge_ai_rtc: rtc@6f {
+		compatible = "isil,isl1219";
+		reg = <0x6f>;
+		status = "okay";
+	};
+};
diff --git a/hardware/nvidia/t23x/nv-public/overlay/tegra234-edge-ai-rs485.dts b/hardware/nvidia/t23x/nv-public/overlay/tegra234-edge-ai-rs485.dts
new file mode 100644
--- /dev/null
+++ b/hardware/nvidia/t23x/nv-public/overlay/tegra234-edge-ai-rs485.dts
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/dts-v1/;
+/plugin/;
+
+/ {
+	overlay-name = "CompuLab dedicated RS-485 UART";
+	compatible = "nvidia,tegra234";
+};
+
+&{/aliases} {
+	serial3 = "/bus@0/serial@3110000";
+};
+
+&{/bus@0/serial@3110000} {
+	/* Avoid competing with the ordinary serial-tegra driver. */
+	compatible = "nvidia,tegra194-hsuart-rs485";
+	reset-names = "serial";
+	status = "okay";
+};
diff --git a/hardware/nvidia/t23x/nv-public/overlay/tegra234-edge-ai-watchdog-template.dts b/hardware/nvidia/t23x/nv-public/overlay/tegra234-edge-ai-watchdog-template.dts
new file mode 100644
--- /dev/null
+++ b/hardware/nvidia/t23x/nv-public/overlay/tegra234-edge-ai-watchdog-template.dts
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/dts-v1/;
+/plugin/;
+
+/ {
+	overlay-name = "CompuLab external watchdog template (disabled)";
+	compatible = "nvidia,tegra234";
+};
+
+&{/} {
+	watchdog-ext {
+		compatible = "linux,wdt-gpio-ext";
+		hw_algo = "toggle";
+		hw_margin_ms = <1600>;
+		/* Add confirmed ping-gpios and enable-gpios before enabling. */
+		status = "disabled";
+	};
+};
