diff --git a/hardware/nvidia/t23x/nv-public/overlay/tegra234-edge-ai-eb-edgerpi4.dts b/hardware/nvidia/t23x/nv-public/overlay/tegra234-edge-ai-eb-edgerpi4.dts
new file mode 100644
--- /dev/null
+++ b/hardware/nvidia/t23x/nv-public/overlay/tegra234-edge-ai-eb-edgerpi4.dts
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/dts-v1/;
+/plugin/;
+
+/ {
+	overlay-name = "CompuLab EB-EdgeRPI4 GPIO expander and RTC";
+	compatible = "nvidia,tegra234";
+};
+
+&hdr40_i2c1 {
+	status = "okay";
+	#address-cells = <1>;
+	#size-cells = <0>;
+	edge_ai_pca9555: gpio@20 {
+		compatible = "nxp,pca9555";
+		reg = <0x20>;
+		gpio-controller;
+		#gpio-cells = <2>;
+		status = "okay";
+	};
+	edge_ai_rtc: rtc@6f {
+		compatible = "isil,isl1219";
+		reg = <0x6f>;
+		status = "okay";
+	};
+};
diff --git a/hardware/nvidia/t23x/nv-public/overlay/tegra234-edge-ai-rs485.dts b/hardware/nvidia/t23x/nv-public/overlay/tegra234-edge-ai-rs485.dts
new file mode 100644
--- /dev/null
+++ b/hardware/nvidia/t23x/nv-public/overlay/tegra234-edge-ai-rs485.dts
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/dts-v1/;
+/plugin/;
+
+/ {
+	overlay-name = "CompuLab dedicated RS-485 UART";
+	compatible = "nvidia,tegra234";
+};
+
+&{/aliases} {
+	serial3 = "/bus@0/serial@3110000";
+};
+
+&{/bus@0/serial@3110000} {
+	/* Avoid competing with the ordinary serial-tegra driver. */
+	compatible = "nvidia,tegra194-hsuart-rs485";
+	reset-names = "serial";
+	status = "okay";
+};
diff --git a/hardware/nvidia/t23x/nv-public/overlay/tegra234-edge-ai-watchdog-template.dts b/hardware/nvidia/t23x/nv-public/overlay/tegra234-edge-ai-watchdog-template.dts
new file mode 100644
--- /dev/null
+++ b/hardware/nvidia/t23x/nv-public/overlay/tegra234-edge-ai-watchdog-template.dts
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/dts-v1/;
+/plugin/;
+
+/ {
+	overlay-name = "CompuLab external watchdog template (disabled)";
+	compatible = "nvidia,tegra234";
+};
+
+&{/} {
+	watchdog-ext {
+		compatible = "linux,wdt-gpio-ext";
+		hw_algo = "toggle";
+		hw_margin_ms = <1600>;
+		/* Add confirmed ping-gpios and enable-gpios before enabling. */
+		status = "disabled";
+	};
+};
