@@ -2048,6 +2220,7 @@ int tegra_channel_init_subdevices(struct tegra_channel *chan)
 	struct media_pad *pad;
 	struct v4l2_subdev *sd;
 	int index = 0;
+	u32 stream = 0;
 	u8 num_sd = 0;
 	struct tegra_camera_dev_info camdev_info;
 	int grp_id = chan->pg_mode ? (TPG_CSI_GROUP_ID + chan->port[0] + 1)
@@ -2079,8 +2252,29 @@ int tegra_channel_init_subdevices(struct tegra_channel *chan)
 
 	sd->grp_id = grp_id;
 	chan->grp_id = grp_id;
-	index = pad->index - 1;
-	while (index >= 0) {
