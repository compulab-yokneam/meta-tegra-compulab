 }
 EXPORT_SYMBOL(tegra_channel_write_blobs);
 
+/* Select one routed stream by its CSI-2 virtual channel, not by pad order. */
+static int tegra_channel_stream_id(struct tegra_channel *chan,
+				   struct v4l2_subdev *sd, u32 pad,
+				   u32 *stream)
+{
+	struct v4l2_mbus_frame_desc fd = { 0 };
+	unsigned int i;
+	int ret;
+
+	ret = v4l2_subdev_call(sd, pad, get_frame_desc, pad, &fd);
+	if (ret)
+		return ret;
+	if (fd.type != V4L2_MBUS_FRAME_DESC_TYPE_CSI2)
+		return -EINVAL;
+
+	for (i = 0; i < fd.num_entries; i++) {
+		if (fd.entry[i].bus.csi2.vc != chan->virtual_channel)
+			continue;
+		*stream = fd.entry[i].stream;
+		return *stream < 64 ? 0 : -EINVAL;
+	}
+
+	return -ENOLINK;
+}
+
+static int tegra_channel_route_sink(struct v4l2_subdev *sd, u32 source_pad,
+				    u32 source_stream, u32 *sink_pad,
+				    u32 *sink_stream)
+{
+	struct v4l2_subdev_state *state;
+	struct v4l2_subdev_route *route;
+	int ret = -ENOLINK;
+
+	state = v4l2_subdev_lock_and_get_active_state(sd);
+	if (!state)
+		return -EINVAL;
+
+	for_each_active_route(&state->routing, route) {
+		if (route->source_pad != source_pad ||
+		    route->source_stream != source_stream)
+			continue;
+		*sink_pad = route->sink_pad;
+		*sink_stream = route->sink_stream;
+		ret = 0;
+		break;
+	}
+	v4l2_subdev_unlock_state(state);
+
+	return ret;
+}
+
+/*
+ * Propagate the selected sensor format through stream-aware bridge state.
+ * ADI configures CSI datatypes from frame descriptors, but link validation
+ * also needs matching formats on the connected pads.
+ */
+static int tegra_channel_sync_stream_formats(struct tegra_channel *chan)
+{
+	struct v4l2_subdev_format format = {
+		.which = V4L2_SUBDEV_FORMAT_ACTIVE,
+	};
+	struct media_entity *entity;
+	struct media_pad *pad;
+	u32 stream;
+	int ret;
+
+	if (!chan->stream_subdev)
+		return 0;
+
+	ret = v4l2_subdev_call(chan->subdev_on_csi, pad, get_fmt, NULL,
+			       &format);
+	if (ret)
+		return ret;
+
+	entity = &chan->stream_subdev->entity;
+	pad = &entity->pads[chan->stream_pad];
+	stream = __ffs64(chan->stream_mask);
+
+	while (pad) {
+		struct v4l2_subdev *sd = media_entity_to_v4l2_subdev(entity);
+		struct v4l2_subdev_state *state;
+		struct v4l2_subdev_format current_fmt = {
+			.which = V4L2_SUBDEV_FORMAT_ACTIVE,
+		};
+		u32 sink_pad, sink_stream;
+
+		if (!(sd->flags & V4L2_SUBDEV_FL_STREAMS))
+			break;
+		ret = tegra_channel_route_sink(sd, pad->index, stream,
+					      &sink_pad, &sink_stream);
+		if (ret)
+			return ret;
+		state = v4l2_subdev_lock_and_get_active_state(sd);
+		if (!state)
+			return -EINVAL;
+		format.pad = sink_pad;
+		format.stream = sink_stream;
+		current_fmt.pad = sink_pad;
+		current_fmt.stream = sink_stream;
+		ret = v4l2_subdev_call(sd, pad, get_fmt, state, &current_fmt);
+		/* A matching active route needs no forbidden format mutation. */
+		if (!ret && (current_fmt.format.width != format.format.width ||
+			     current_fmt.format.height != format.format.height ||
+			     current_fmt.format.code != format.format.code ||
+			     current_fmt.format.field != format.format.field))
+			ret = v4l2_subdev_call(sd, pad, set_fmt, state, &format);
+		v4l2_subdev_unlock_state(state);
+		if (ret)
+			return ret;
+
+#if defined(NV_MEDIA_ENTITY_REMOTE_PAD_PRESENT)
+		pad = media_entity_remote_pad(&entity->pads[sink_pad]);
+#else
+		pad = media_pad_remote_pad_first(&entity->pads[sink_pad]);
+#endif
+		if (!pad)
+			return -ENOLINK;
+		entity = pad->entity;
+		stream = sink_stream;
+	}
+
+	return 0;
+}
+
+static int tegra_channel_stream_subdev(struct tegra_channel *chan,
+				      int index, bool on)
+{
+	struct v4l2_subdev *sd = chan->subdev[index];
+	int i;
+
+	if (!chan->stream_subdev)
+		return v4l2_subdev_call(sd, video, s_stream, on);
+
+	if (sd == chan->stream_subdev) {
+		if (on)
+			return v4l2_subdev_enable_streams(sd, chan->stream_pad,
+							 chan->stream_mask);
+		return v4l2_subdev_disable_streams(sd, chan->stream_pad,
+						  chan->stream_mask);
+	}
+
+	/* The bridge recursively starts/stops all of its upstream sources. */
+	for (i = 0; i < index; i++)
+		if (chan->subdev[i] == chan->stream_subdev)
+			return 0;
+
+	return v4l2_subdev_call(sd, video, s_stream, on);
+}
