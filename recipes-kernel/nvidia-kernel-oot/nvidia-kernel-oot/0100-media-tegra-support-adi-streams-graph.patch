+++ b/drivers/media/platform/tegra/camera/sensor_common.c
@@ -744,6 +744,25 @@ static int sensor_common_init_i2c_device_config(
 		}
 	}
 
+	/*
+	 * An I2C gate or address translator may introduce several virtual
+	 * adapters above a sensor. Find the physical controller for the
+	 * NVIDIA sensor metadata instead of treating the first gate as MMIO.
+	 */
+	while (parent &&
+	       of_property_read_u32_index(parent, "reg", 1, &value)) {
