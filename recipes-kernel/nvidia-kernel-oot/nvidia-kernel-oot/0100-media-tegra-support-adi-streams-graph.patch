+			csi_chan->sensor_sd = sensor_sd;
+			return 0;
+		}
+		return -ENODEV;
+	}
+
 	for_each_endpoint_of_node(sensor_of_node, ep_node) {
 		struct device_node *csi_chan_of_node;
 		struct tegra_csi_channel *csi_chan;
@@ -2038,6 +2208,8 @@ void tegra_channel_remove_subdevices(struct tegra_channel *chan)
