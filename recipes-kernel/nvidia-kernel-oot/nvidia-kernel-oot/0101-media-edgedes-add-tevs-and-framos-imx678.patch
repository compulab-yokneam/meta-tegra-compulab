diff --git a/drivers/media/i2c/edgedes-sensors/Kconfig b/drivers/media/i2c/edgedes-sensors/Kconfig
new file mode 100644
index 0000000..ef2613c
--- /dev/null
+++ b/drivers/media/i2c/edgedes-sensors/Kconfig
@@ -0,0 +1,16 @@
+# SPDX-License-Identifier: GPL-2.0-only
+# The NVIDIA OOT build emits these modules through obj-m in the Makefile.
+config VIDEO_EDGEDES_TEVS
+	tristate "TechNexion TEVS sensor on the EDGEDES ADI transport"
+	depends on I2C && VIDEO_DEV && VIDEO_V4L2_SUBDEV_API
+	help
+	  Sensor control and NVIDIA tegracam metadata for TechNexion TEVS modules.
+	  GMSL streaming and address translation are supplied by the ADI drivers.
+
+config VIDEO_EDGEDES_FRAMOS_IMX678
+	tristate "FRAMOS IMX678 sensor on the EDGEDES ADI transport"
+	depends on I2C && VIDEO_DEV && VIDEO_V4L2_SUBDEV_API
+	help
+	  Native 3856x2180 RAW12 at 10 FPS for FRAMOS FSM:GO IMX678 modules.
+	  This preserves the required 200 ms XCLR delay and generic GPIO/clock
+	  consumers while the ADI parent subdevices control GMSL streaming.
