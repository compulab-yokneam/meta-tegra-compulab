From 33c363e0a691a8401d219a6de14d08495b6b4033 Mon Sep 17 00:00:00 2001
From: Igor Derzhavets <igor.derzhavets@compulab.co.il>
Date: Sun, 4 Oct 2026 19:18:50 +0300
Subject: [PATCH] media: maxim-serdes: adapt ADI v18 to Linux 6.18 interfaces

Use the Linux 6.18 set_fmt callback signature. Keep dynamic register masks in driver-local helpers because FIELD_GET/FIELD_PREP in this kernel require compile-time masks.

Upstream-Status: Inappropriate [Linux 6.18 compatibility backport]
---
 drivers/media/i2c/maxim-serdes/max9296a.c   | 10 +++++-----
 drivers/media/i2c/maxim-serdes/max96717.c   | 12 ++++++------
 drivers/media/i2c/maxim-serdes/max96724.c   | 20 ++++++++++----------
 drivers/media/i2c/maxim-serdes/max_des.c    |  1 -
 drivers/media/i2c/maxim-serdes/max_ser.c    |  1 -
 drivers/media/i2c/maxim-serdes/max_serdes.h | 13 +++++++++++++
 6 files changed, 34 insertions(+), 23 deletions(-)

diff --git a/drivers/media/i2c/maxim-serdes/max9296a.c b/drivers/media/i2c/maxim-serdes/max9296a.c
index 7b25b54..14b99dc 100644
--- a/drivers/media/i2c/maxim-serdes/max9296a.c
+++ b/drivers/media/i2c/maxim-serdes/max9296a.c
@@ -335,7 +335,7 @@ static int max9296a_log_phy_status(struct max_des *des,
 		return ret;
 
 	dev_info(priv->dev, "\tcsi2_pkt_cnt: %lu\n",
-		 field_get(MAX9296A_MIPI_PHY18_CSI2_TX_PKT_CNT(index), val));
+		 max_serdes_field_get(MAX9296A_MIPI_PHY18_CSI2_TX_PKT_CNT(index), val));
 
 	ret = regmap_read(priv->regmap, MAX9296A_MIPI_PHY20(index), &val);
 	if (ret)
@@ -688,7 +688,7 @@ static int max9296a_set_pipe_remap(struct max_des *des,
 	/* Set destination PHY. */
 	return regmap_update_bits(priv->regmap, MAX9296A_MIPI_TX45(index, i),
 				  MAX9296A_MIPI_TX45_MAP_DPHY_DEST(i),
-				  field_prep(MAX9296A_MIPI_TX45_MAP_DPHY_DEST(i),
+				  max_serdes_field_prep(MAX9296A_MIPI_TX45_MAP_DPHY_DEST(i),
 					     phy_id));
 }
 
@@ -755,7 +755,7 @@ static int max96714_set_pipe_stream_id(struct max_des *des, struct max_des_pipe
 
 	return regmap_update_bits(priv->regmap, MAX9296A_VIDEO_PIPE_SEL,
 				  MAX9296A_VIDEO_PIPE_SEL_STREAM(index),
-				  field_prep(MAX9296A_VIDEO_PIPE_SEL_STREAM(index),
+				  max_serdes_field_prep(MAX9296A_VIDEO_PIPE_SEL_STREAM(index),
 					     stream_id));
 }
 
@@ -767,7 +767,7 @@ static int max96716a_set_pipe_link(struct max_des *des, struct max_des_pipe *pip
 
 	return regmap_update_bits(priv->regmap, MAX9296A_VIDEO_PIPE_SEL,
 				  MAX9296A_VIDEO_PIPE_SEL_LINK(index),
-				  field_prep(MAX9296A_VIDEO_PIPE_SEL_LINK(index),
+				  max_serdes_field_prep(MAX9296A_VIDEO_PIPE_SEL_LINK(index),
 					     link->index));
 }
 
@@ -973,7 +973,7 @@ static int max9296a_set_link_version(struct max_des *des,
 	else
 		val = MAX9296A_REG1_RX_RATE_3GBPS;
 
-	ret = regmap_update_bits(priv->regmap, reg, mask, field_prep(mask, val));
+	ret = regmap_update_bits(priv->regmap, reg, mask, max_serdes_field_prep(mask, val));
 	if (ret)
 		return ret;
 
diff --git a/drivers/media/i2c/maxim-serdes/max96717.c b/drivers/media/i2c/maxim-serdes/max96717.c
index c87ea9e..6145cf3 100644
--- a/drivers/media/i2c/maxim-serdes/max96717.c
+++ b/drivers/media/i2c/maxim-serdes/max96717.c
@@ -504,7 +504,7 @@ static int max96717_conf_pin_config_get(struct pinctrl_dev *pctldev,
 		if (ret)
 			return ret;
 
-		val = field_get(mask, val) == en_val;
+		val = max_serdes_field_get(mask, val) == en_val;
 		if (!val)
 			return -EINVAL;
 
@@ -518,7 +518,7 @@ static int max96717_conf_pin_config_get(struct pinctrl_dev *pctldev,
 		if (ret)
 			return ret;
 
-		val = field_get(mask, val) == en_val;
+		val = max_serdes_field_get(mask, val) == en_val;
 		break;
 	case MAX96717_PINCTRL_TX_ID:
 	case MAX96717_PINCTRL_RX_ID:
@@ -527,7 +527,7 @@ static int max96717_conf_pin_config_get(struct pinctrl_dev *pctldev,
 		if (ret)
 			return ret;
 
-		val = field_get(mask, val);
+		val = max_serdes_field_get(mask, val);
 		break;
 	default:
 		return -ENOTSUPP;
@@ -593,7 +593,7 @@ static int max96717_conf_pin_config_set_one(struct max96717_priv *priv,
 	case PIN_CONFIG_BIAS_DISABLE:
 	case PIN_CONFIG_BIAS_PULL_DOWN:
 	case PIN_CONFIG_BIAS_PULL_UP:
-		val = field_prep(mask, en_val);
+		val = max_serdes_field_prep(mask, en_val);
 
 		ret = regmap_update_bits(priv->regmap, reg, mask, val);
 		break;
@@ -604,14 +604,14 @@ static int max96717_conf_pin_config_set_one(struct max96717_priv *priv,
 	case PIN_CONFIG_OUTPUT_ENABLE:
 	case PIN_CONFIG_INPUT_ENABLE:
 	case PIN_CONFIG_LEVEL:
-		val = field_prep(mask, arg ? en_val : ~en_val);
+		val = max_serdes_field_prep(mask, arg ? en_val : ~en_val);
 
 		ret = regmap_update_bits(priv->regmap, reg, mask, val);
 		break;
 	case MAX96717_PINCTRL_TX_ID:
 	case MAX96717_PINCTRL_RX_ID:
 	case PIN_CONFIG_SLEW_RATE:
-		val = field_prep(mask, arg);
+		val = max_serdes_field_prep(mask, arg);
 
 		ret = regmap_update_bits(priv->regmap, reg, mask, val);
 		break;
diff --git a/drivers/media/i2c/maxim-serdes/max96724.c b/drivers/media/i2c/maxim-serdes/max96724.c
index 3889d95..cf1075a 100644
--- a/drivers/media/i2c/maxim-serdes/max96724.c
+++ b/drivers/media/i2c/maxim-serdes/max96724.c
@@ -416,14 +416,14 @@ static int max96724_log_phy_status(struct max_des *des,
 		return ret;
 
 	dev_info(priv->dev, "\tcsi2_pkt_cnt: %lu\n",
-		 field_get(MAX96724_MIPI_PHY25_CSI2_TX_PKT_CNT(index), val));
+		 max_serdes_field_get(MAX96724_MIPI_PHY25_CSI2_TX_PKT_CNT(index), val));
 
 	ret = regmap_read(priv->regmap, MAX96724_MIPI_PHY27(index), &val);
 	if (ret)
 		return ret;
 
 	dev_info(priv->dev, "\tphy_pkt_cnt: %lu\n",
-		 field_get(MAX96724_MIPI_PHY27_PHY_PKT_CNT(index), val));
+		 max_serdes_field_get(MAX96724_MIPI_PHY27_PHY_PKT_CNT(index), val));
 
 	return 0;
 }
@@ -578,7 +578,7 @@ static int max96724_init_phy(struct max_des *des, struct max_des_phy *phy)
 		mask = MAX96724_MIPI_PHY3_PHY_LANE_MAP_2(index);
 
 	ret = regmap_update_bits(priv->regmap, MAX96724_MIPI_PHY3(index),
-				 mask, field_prep(mask, val));
+				 mask, max_serdes_field_prep(mask, val));
 	if (ret)
 		return ret;
 
@@ -606,7 +606,7 @@ static int max96724_init_phy(struct max_des *des, struct max_des_phy *phy)
 	} else {
 		ret = regmap_update_bits(priv->regmap, MAX96724_MIPI_PHY5(index),
 					 MAX96724_MIPI_PHY5_PHY_POL_MAP_2(index),
-					 field_prep(MAX96724_MIPI_PHY5_PHY_POL_MAP_2(index), val));
+					 max_serdes_field_prep(MAX96724_MIPI_PHY5_PHY_POL_MAP_2(index), val));
 		if (ret)
 			return ret;
 
@@ -774,7 +774,7 @@ static int max96724_set_pipe_remap(struct max_des *des,
 	/* Set destination PHY. */
 	return regmap_update_bits(priv->regmap, MAX96724_MIPI_TX45(index, i),
 				  MAX96724_MIPI_TX45_MAP_DPHY_DEST(i),
-				  field_prep(MAX96724_MIPI_TX45_MAP_DPHY_DEST(i),
+				  max_serdes_field_prep(MAX96724_MIPI_TX45_MAP_DPHY_DEST(i),
 					     phy_id));
 }
 
@@ -814,7 +814,7 @@ static int max96724_set_pipe_phy(struct max_des *des, struct max_des_pipe *pipe,
 
 	return regmap_update_bits(priv->regmap, MAX96724_MIPI_CTRL_SEL,
 				  MAX96724_MIPI_CTRL_SEL_MASK(pipe->index),
-				  field_prep(MAX96724_MIPI_CTRL_SEL_MASK(pipe->index),
+				  max_serdes_field_prep(MAX96724_MIPI_CTRL_SEL_MASK(pipe->index),
 					     phy_index));
 }
 
@@ -836,7 +836,7 @@ static int max96724_set_pipe_stream_id(struct max_des *des, struct max_des_pipe
 
 	return regmap_update_bits(priv->regmap, MAX96724_VIDEO_PIPE_SEL(index),
 				  MAX96724_VIDEO_PIPE_SEL_STREAM(index),
-				  field_prep(MAX96724_VIDEO_PIPE_SEL_STREAM(index),
+				  max_serdes_field_prep(MAX96724_VIDEO_PIPE_SEL_STREAM(index),
 					     stream_id));
 }
 
@@ -848,7 +848,7 @@ static int max96724_set_pipe_link(struct max_des *des, struct max_des_pipe *pipe
 
 	return regmap_update_bits(priv->regmap, MAX96724_VIDEO_PIPE_SEL(index),
 				  MAX96724_VIDEO_PIPE_SEL_LINK(index),
-				  field_prep(MAX96724_VIDEO_PIPE_SEL_LINK(index),
+				  max_serdes_field_prep(MAX96724_VIDEO_PIPE_SEL_LINK(index),
 					     link->index));
 }
 
@@ -978,7 +978,7 @@ static int max96724_select_links(struct max_des *des, unsigned int mask)
 		return ret;
 
 	ret = regmap_update_bits(priv->regmap, MAX96724_REG6, MAX96724_REG6_LINK_EN,
-				 field_prep(MAX96724_REG6_LINK_EN, mask));
+				 max_serdes_field_prep(MAX96724_REG6_LINK_EN, mask));
 	if (ret)
 		return ret;
 
@@ -1005,7 +1005,7 @@ static int max96724_set_link_version(struct max_des *des,
 
 	return regmap_update_bits(priv->regmap, MAX96724_REG26(index),
 				  MAX96724_REG26_RX_RATE_PHY(index),
-				  field_prep(MAX96724_REG26_RX_RATE_PHY(index), val));
+				  max_serdes_field_prep(MAX96724_REG26_RX_RATE_PHY(index), val));
 }
 
 static int max96724_set_tpg_timings(struct max96724_priv *priv,
diff --git a/drivers/media/i2c/maxim-serdes/max_des.c b/drivers/media/i2c/maxim-serdes/max_des.c
index 1cbe4c3..8b6bed6 100644
--- a/drivers/media/i2c/maxim-serdes/max_des.c
+++ b/drivers/media/i2c/maxim-serdes/max_des.c
@@ -1893,7 +1893,6 @@ static int max_des_set_tpg_fmt(struct v4l2_subdev *sd,
 }
 
 static int max_des_set_fmt(struct v4l2_subdev *sd,
-			   const struct v4l2_subdev_client_info *ci,
 			   struct v4l2_subdev_state *state,
 			   struct v4l2_subdev_format *format)
 {
diff --git a/drivers/media/i2c/maxim-serdes/max_ser.c b/drivers/media/i2c/maxim-serdes/max_ser.c
index e9bb722..0c47570 100644
--- a/drivers/media/i2c/maxim-serdes/max_ser.c
+++ b/drivers/media/i2c/maxim-serdes/max_ser.c
@@ -480,7 +480,6 @@ static int max_ser_set_tpg_fmt(struct v4l2_subdev *sd,
 }
 
 static int max_ser_set_fmt(struct v4l2_subdev *sd,
-			   const struct v4l2_subdev_client_info *ci,
 			   struct v4l2_subdev_state *state,
 			   struct v4l2_subdev_format *format)
 {
diff --git a/drivers/media/i2c/maxim-serdes/max_serdes.h b/drivers/media/i2c/maxim-serdes/max_serdes.h
index 1679b38..7ee4507 100644
--- a/drivers/media/i2c/maxim-serdes/max_serdes.h
+++ b/drivers/media/i2c/maxim-serdes/max_serdes.h
@@ -12,6 +12,19 @@
 #include <media/mipi-csi2.h>
 #include <media/v4l2-subdev.h>
 
+/* Linux 6.18 lacks the dynamic-mask field_get()/field_prep() helpers. */
+static inline unsigned long max_serdes_field_get(unsigned long mask,
+						unsigned long value)
+{
+	return (value & mask) >> __ffs(mask);
+}
+
+static inline unsigned long max_serdes_field_prep(unsigned long mask,
+						 unsigned long value)
+{
+	return (value << __ffs(mask)) & mask;
+}
+
 #define REG_SEQUENCE_2(reg, val) \
 	{ (reg),     ((val) >> 8) & 0xff }, \
 	{ (reg) + 1, ((val) >> 0) & 0xff }
