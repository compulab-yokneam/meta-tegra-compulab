+static ssize_t arc_enable_store(struct device *dev,
+				struct device_attribute *attr,
+				const char *buf, size_t count)
+{
+	struct rk628_csi *csi = dev_get_drvdata(dev);
+	struct rk_hdmirx_dev *hdmirx_dev = dev_get_drvdata(dev);
+	bool enabled;
+	int ret;
+
