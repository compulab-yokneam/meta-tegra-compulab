+#ifndef _RK628_COMBTXPHY_H
+#define _RK628_COMBTXPHY_H
+
+#define COMBTXPHY_BASE		0x90000
+#define COMBTXPHY_REG(x)	((x) + COMBTXPHY_BASE)
+
+#define COMBTXPHY_CON0		COMBTXPHY_REG(0x0000)
