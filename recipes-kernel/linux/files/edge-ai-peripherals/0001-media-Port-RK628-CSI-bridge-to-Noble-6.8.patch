Subject: [PATCH] media: Port RK628 CSI bridge to Noble 6.8

Based on edge-ai-linux devel kernel patches 0008, 0010 (HDMI class only),
0011, 0013 and 0014. Adapt the V4L2 state, frame interval, CSI-2 bus,
class_create and I2C probe APIs to Linux 6.8. Retain the Tegra UYVY alias
and unchanged-HDMI-timing fixes. Do not add competing RK628 drivers.

Upstream-Status: Inappropriate [CompuLab Edge-AI peripheral ports]

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -1578,3 +1578,5 @@
 endmenu
 
 endif # VIDEO_DEV
+
+source "drivers/media/i2c/rk628/Kconfig"
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -153,3 +153,5 @@
 obj-$(CONFIG_VIDEO_VPX3220) += vpx3220.o
 obj-$(CONFIG_VIDEO_WM8739) += wm8739.o
 obj-$(CONFIG_VIDEO_WM8775) += wm8775.o
+
+obj-$(CONFIG_VIDEO_RK628) += rk628/
diff --git a/drivers/media/i2c/rk628/Kconfig b/drivers/media/i2c/rk628/Kconfig
new file mode 100644
--- /dev/null
+++ b/drivers/media/i2c/rk628/Kconfig
@@ -0,0 +1,18 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config VIDEO_ROCKCHIP_HDMIRX_CLASS
+	tristate
+
+config VIDEO_RK628
+	tristate
+	select CEC_CORE
+
+config VIDEO_RK628_CSI
+	tristate "Rockchip RK628 HDMI to CSI-2 bridge"
+	depends on VIDEO_DEV && I2C && VIDEO_V4L2_SUBDEV_API
+	select HDMI
+	select V4L2_FWNODE
+	select VIDEO_RK628
+	select VIDEO_ROCKCHIP_HDMIRX_CLASS
+	help
+	  Build the RK628 HDMI receiver and MIPI CSI-2 bridge used by
+	  the CompuLab HDMI-to-CSI adapter.
