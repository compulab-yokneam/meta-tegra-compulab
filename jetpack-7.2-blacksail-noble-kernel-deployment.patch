@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Check the effective kernel selection and the active CompuLab snapshot."""
+import hashlib
+import json
+from pathlib import Path
+import re
+import sys
+
+ROOT = Path(__file__).resolve().parent
+SOURCE = ROOT.parents[1]
+EXPECT = {
+    'PN': 'linux-noble-nvidia-tegra', 'MACHINE': 'edge-ai-nx-16g',
+    'PREFERRED_PROVIDER_virtual/kernel': 'linux-noble-nvidia-tegra',
+    'TEGRA_DEFAULT_KERNEL': 'linux-noble-nvidia-tegra', 'TEGRA_USING_VENDOR_KERNEL': '1',
+    'SRCREV': '78272943bba3a47e633b28963b0cda60de503500',
+    'SRCBRANCH': 'l4t/l4t-r39.2.1-Ubuntu-nvidia-tegra-6.8.0-1021.21',
+    'PV': '6.8.12', 'BBMULTICONFIG': '',
+}
+
+
+def main():
+    env = Path(sys.argv[1]).read_text()
+    values = {}
+    for name, expected in EXPECT.items():
+        match = re.search(r'^' + re.escape(name) + r'="(.*)"$', env, re.M)
+        assert match and match.group(1) == expected, f'Unexpected {name}'
+        values[name] = match.group(1)
+    layers = re.search(r'^BBLAYERS="(.*)"$', env, re.M).group(1).split()
+    active = [Path(p) for p in layers if Path(p).name == 'meta-tegra-compulab']
+    assert len(active) == 1, f'Unexpected active CompuLab layers: {active}'
+    inventory = {}
+    for base in ['recipes-kernel', 'conf/machine']:
+        for path in sorted((SOURCE / base).rglob('*')):
+            if path.is_file():
+                relative = path.relative_to(SOURCE)
+                copy = active[0] / relative
+                assert copy.is_file() and copy.read_bytes() == path.read_bytes(), f'Active layer differs: {relative}'
+                inventory[str(relative)] = hashlib.sha256(path.read_bytes()).hexdigest()
+    result = {'effective_kernel': values, 'source_root': str(SOURCE),
+              'active_compulab_layer': str(active[0]), 'source_files': inventory}
+    (ROOT / 'logs/build-preflight.json').write_text(json.dumps(result, indent=2) + '\n')
+    print(f'Preflight passed: provider/source pin and {len(inventory)} active layer files checked')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/.build-jetpack-7.2-blacksail/noble-kernel/capture-boot-files.py b/.build-jetpack-7.2-blacksail/noble-kernel/capture-boot-files.py
new file mode 100644
