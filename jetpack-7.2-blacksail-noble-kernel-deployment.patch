+#!/usr/bin/env bash
+set -eo pipefail
+clab_noble_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
+clab_distro_root=$(cd -- "$clab_noble_root/../tegra-demo-distro" && pwd)
+mkdir -p "$clab_noble_root/logs"
+trap 'clab_noble_rc=$?; printf "%s\n" "$clab_noble_rc" > "$clab_noble_root/logs/build.exit"' EXIT
+cd "$clab_distro_root"
+export MACHINE=edge-ai-nx-16g DISTRO=tegrademo
+source ./setup-env build-edge-ai-nx-16g-noble > "$clab_noble_root/logs/setup.log" 2>&1
+bitbake -T 600 -e virtual/kernel > "$clab_noble_root/logs/kernel-environment.log" 2>&1
+python3 "$clab_noble_root/preflight-build.py" "$clab_noble_root/logs/kernel-environment.log" > "$clab_noble_root/logs/preflight.log" 2>&1
+bitbake -T 600 virtual/kernel nvidia-kernel-oot nvidia-kernel-oot-dtb nvidia-kernel-oot-dtbo tegra-minimal-initramfs l4t-launcher-extlinux > "$clab_noble_root/logs/build.log" 2>&1
